#!/usr/bin/env bash
# PodTorrent headless launcher for Linux AMD (Ryzen AI Max / Strix Halo, gfx1151), NVIDIA Jetson (AGX Orin,
# JetPack 6 or 7; a PLATFORM file saying jetson) and Apple Silicon Macs (PLATFORM macos: MLX, launchd).
#
#   ./podtorrent setup              guided first run: checks, GPU, name, model and layers, service, network
#   ./podtorrent peer               preflight, install PyTorch (or MLX) on first run, run this machine's peer,
#                                   and keep it on the PodTorrent network once joined
#   ./podtorrent join               join the PodTorrent network as a node (asks for the node token)
#   ./podtorrent leave              stop serving the network (the peer keeps running in the swarm)
#   ./podtorrent preflight          check the OS, GPU driver and permissions only
#   ./podtorrent gpu-check          run a computation on the GPU with the installed PyTorch (or MLX)
#   ./podtorrent doctor             check everything and write a bundle to send us (no token in it)
#   ./podtorrent install-service    run the peer as a service: systemd --user on Linux, launchd on macOS
#                                   (macOS: --at-boot starts it at boot with nobody logged in; asks for sudo)
#   ./podtorrent uninstall-service  remove that service
#   ./podtorrent top                live view of this machine and the swarm (status: once; status --json)
#   ./podtorrent models | swarm | serve | unserve | pod   the engine's commands, against the running peer
#
# Data (models, venv, logs) lives in ~/.podtorrent, or the folder named in ~/.podtorrent/location,
# the same place the desktop app uses. Extra arguments after `peer` go to `podtorrent peer`.
# Runs on bash 3.2 (macOS's /bin/bash): no mapfile, no ${x,,}, and empty arrays only as ${a[@]+"${a[@]}"}.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
BACKEND="$HERE/backend"
UV="$BACKEND/uv"
AGENT="$BACKEND/podtorrent-agent"
PORT="${PODTORRENT_PORT:-27183}"
DEFAULT_DIR="$HOME/.podtorrent"
SERVICE=podtorrent.service
MIN_KERNEL=6.14
# ROCm PyTorch plus Python and the venv come to about 15 GB; leave room for the cache too.
NEED_GB=25
# Which build this is: rocm (AMD, the default for tarballs from before the file existed), jetson or macos.
FLAVOR="$(head -n1 "$HERE/PLATFORM" 2>/dev/null || echo rocm)"
# macOS: the launchd job. A LaunchAgent (no root) by default; install-service --at-boot makes it a
# LaunchDaemon that runs as this user, so it starts at boot with nobody logged in.
LABEL=com.podtorrent.peer
MAC_NEED_GB=2        # Python, MLX and the venv: about 1 GB
MAC_MIN_OS=14.0      # MLX's wheels need macOS 14 or newer
# Jetson: L4T release file (its major version gives the JetPack version), and the PyTorch index per JetPack.
TEGRA_RELEASE="${PODTORRENT_TEGRA_RELEASE:-/etc/nv_tegra_release}"
JETSON_TORCH="$HERE/jetson-torch.txt"

# How the user runs this: `podtorrent` when it is the command on PATH (install.sh puts it there),
# else ./podtorrent from the unpacked folder. Messages and help say it that way; Python reads PODTORRENT_CMD.
ME=./podtorrent
if [[ "$(readlink -f "$(command -v podtorrent 2>/dev/null)" 2>/dev/null)" == "$(readlink -f "${BASH_SOURCE[0]}")" ]]; then
  ME=podtorrent
fi
export PODTORRENT_CMD="$ME"

say() { printf 'podtorrent: %s\n' "$*"; }
die() { printf 'podtorrent: %s\n' "$*" >&2; exit 1; }
# Colors and the setup banner: only on a terminal, and never with NO_COLOR.
if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-dumb}" != dumb ]]; then
  C_ACC=$'\033[38;5;209m' C_DIM=$'\033[2m' C_BOLD=$'\033[1m' C_OFF=$'\033[0m'
else
  C_ACC="" C_DIM="" C_BOLD="" C_OFF=""
fi
# step N TOTAL TITLE: a step header that stands out from the lines under it.
step() { printf '\n%s●%s %sstep %s/%s%s  %s\n' "$C_ACC" "$C_OFF" "$C_BOLD" "$1" "$2" "$C_OFF" "$3"; }
# banner LINE...: a rounded box with "✱ PodTorrent vX" on top. Lines are ASCII so padding is by width.
banner() {
  local v w=54 line i hr=""
  v="$(head -n1 "$HERE/VERSION" 2>/dev/null || true)"
  for ((i = 0; i < w; i++)); do hr="$hr─"; done
  printf '%s╭%s╮%s\n' "$C_ACC" "$hr" "$C_OFF"
  printf '%s│%s %s✱%s %sPodTorrent%s %-*s%s│%s\n' "$C_ACC" "$C_OFF" "$C_ACC" "$C_OFF" "$C_BOLD" "$C_OFF" \
    $((w - 14)) "${v:+v$v}" "$C_ACC" "$C_OFF"
  printf '%s│%s%*s%s│%s\n' "$C_ACC" "$C_OFF" "$w" "" "$C_ACC" "$C_OFF"
  for line in "$@"; do
    printf '%s│%s   %s%-*s%s%s│%s\n' "$C_ACC" "$C_OFF" "$C_DIM" $((w - 3)) "${line:0:$((w - 3))}" "$C_OFF" "$C_ACC" "$C_OFF"
  done
  printf '%s╰%s╯%s\n' "$C_ACC" "$hr" "$C_OFF"
}

# A failure the user can't fix from the message alone: point them at doctor.
HELP="if this keeps happening, run $ME doctor and send us the file it writes"
stuck() { printf 'podtorrent: %s\npodtorrent: %s\n' "$*" "$HELP" >&2; exit 1; }

data_dir() {
  local loc
  if [[ -f "$DEFAULT_DIR/location" ]] && loc="$(head -n1 "$DEFAULT_DIR/location")" && [[ "$loc" == /* ]]; then
    printf '%s\n' "$loc"
  else
    printf '%s\n' "$DEFAULT_DIR"
  fi
}
DATA="$(data_dir)"

# ---- preflight ----

# version_ge A B: A >= B for dotted versions (only the leading numeric parts count).
version_ge() {
  local a b i
  IFS=. read -r -a a <<<"${1%%[!0-9.]*}"
  IFS=. read -r -a b <<<"$2"
  for i in 0 1 2; do
    (( ${a[i]:-0} > ${b[i]:-0} )) && return 0
    (( ${a[i]:-0} < ${b[i]:-0} )) && return 1
  done
  return 0
}

# Paths are overridable so the checks can be tested on another machine.
PF_KERNEL="${PODTORRENT_PF_KERNEL:-$(uname -r)}"
PF_SYS="${PODTORRENT_PF_SYS:-/sys}"
PF_KFD="${PODTORRENT_PF_KFD:-/dev/kfd}"
PF_DRI="${PODTORRENT_PF_DRI:-/dev/dri}"

preflight() {
  [[ "$FLAVOR" != jetson ]] || { preflight_jetson; return; }
  [[ "$FLAVOR" != macos ]] || { preflight_macos; return; }
  local fail=0 groups g missing=() free_kb
  ok() { printf '  ok    %s\n' "$*"; }
  bad() { printf '  FAIL  %s\n' "$1"; printf '        fix: %s\n' "$2"; fail=1; }
  warn() { printf '  warn  %s\n' "$*"; }
  [[ -n "${IN_SETUP:-}" ]] || say "checking this machine"   # setup has its own step header

  [[ "$(uname -s)" == Linux ]] || bad "this launcher is for Linux (found $(uname -s))" "use the desktop app on this machine"
  [[ "$(uname -m)" == x86_64 ]] || bad "this build is for x86_64 (found $(uname -m))" "use a Ryzen AI Max (Strix Halo) machine"

  if version_ge "$PF_KERNEL" "$MIN_KERNEL"; then
    ok "kernel $PF_KERNEL"
  else
    bad "kernel $PF_KERNEL is older than $MIN_KERNEL, which Strix Halo needs for ROCm" \
        "install a $MIN_KERNEL+ kernel (Ubuntu 24.04: sudo apt install linux-generic-hwe-24.04, or Ubuntu 25.04+), then reboot"
  fi

  if [[ -d "$PF_SYS/module/amdgpu" ]]; then
    ok "amdgpu driver loaded"
  else
    bad "the amdgpu kernel driver is not loaded" \
        "sudo modprobe amdgpu (and check dmesg | grep amdgpu); if it is blacklisted, remove the blacklist and reboot"
  fi

  if [[ -r "$PF_KFD" && -w "$PF_KFD" ]]; then
    ok "$PF_KFD is accessible"
  elif [[ -e "$PF_KFD" ]]; then
    bad "$PF_KFD exists but $(id -un) can't open it" "add yourself to the render and video groups (below), then log out and back in"
  else
    bad "$PF_KFD is missing, so ROCm can't reach the GPU" "load amdgpu with a $MIN_KERNEL+ kernel; /dev/kfd appears with it"
  fi

  groups=" $(id -nG) "
  for g in video render; do [[ "$groups" == *" $g "* ]] || missing+=("$g"); done
  if (( ${#missing[@]} == 0 )); then
    ok "$(id -un) is in the video and render groups"
  else
    bad "$(id -un) is not in: ${missing[*]}" \
        "sudo usermod -aG video,render $(id -un), then log out and back in (or reboot)"
  fi

  # Informational: the build's PyTorch wheels are for gfx1151 only.
  if ! grep -qs 'gfx_target_version 110501' "$PF_SYS"/class/kfd/kfd/topology/nodes/*/properties; then
    warn "no gfx1151 GPU found in the KFD topology; this build's PyTorch is for Ryzen AI Max (Radeon 8050S/8060S)"
  fi

  mkdir -p "$DATA"
  if [[ -x "$DATA/venv/bin/python" ]]; then
    ok "PyTorch already installed in $DATA/venv"
  else
    free_kb="$(df -Pk "$DATA" | awk 'NR==2 {print $4}')"
    if (( free_kb / 1024 / 1024 >= NEED_GB )); then
      ok "$(( free_kb / 1024 / 1024 )) GB free in $DATA"
    else
      bad "only $(( free_kb / 1024 / 1024 )) GB free in $DATA; the first run downloads about $NEED_GB GB (ROCm PyTorch)" \
          "free up space, or put the data elsewhere: echo /big/disk/podtorrent > $DEFAULT_DIR/location"
    fi
  fi

  if (( fail )); then
    say "fix the above and run again (PODTORRENT_SKIP_PREFLIGHT=1 skips these checks)"
    say "$HELP"
    return 1
  fi
  say "this machine is ready"
}

# ---- Jetson ----

# The L4T version of this Jetson, e.g. 36.4.3 (from "# R36 (release), REVISION: 4.3, ..."), or nothing.
l4t_version() { sed -n 's/^# R\([0-9][0-9]*\) (release), REVISION: \([0-9.]*\).*/\1.\2/p' "$TEGRA_RELEASE" 2>/dev/null | head -n1; }
# JetPack major for an L4T major: R35 = JetPack 5, R36 = JetPack 6, R38 (Thor) and R39 (Orin) = JetPack 7.
jetpack_major() { case "$1" in 35) echo 5 ;; 36) echo 6 ;; 38|39) echo 7 ;; *) echo "?" ;; esac; }
# "<index> <requirement> [<extra>...]" for a JetPack major from jetson-torch.txt, or nothing. Extras are
# libraries the wheel links to without declaring them (JetPack 7: NVPL); they're installed from PyPI
# without their dependencies.
jetson_torch_for() {
  awk -v jp="$1" '$1 == jp && NF >= 3 { $1 = ""; sub(/^ /, ""); print; exit }' "$JETSON_TORCH" 2>/dev/null
}
jetson_supported() { awk 'NF >= 3 && $1 !~ /^#/ { printf "%s%s", sep, "JetPack " $1; sep = ", " }' "$JETSON_TORCH" 2>/dev/null; }

# The PyTorch index and requirement for this Jetson; exits with what to do when its JetPack has none.
# Prints nothing when this isn't a Jetson at all.
jetson_torch() {
  local l4t jp line
  [[ -r "$TEGRA_RELEASE" ]] || return 0
  l4t="$(l4t_version)"
  [[ -n "$l4t" ]] || die "can't read the JetPack version from $TEGRA_RELEASE ($(head -n1 "$TEGRA_RELEASE" 2>/dev/null)); send that line to PodTorrent support"
  jp="$(jetpack_major "${l4t%%.*}")"
  line="$(jetson_torch_for "$jp")"
  [[ -n "$line" ]] || die "this Jetson runs L4T $l4t (JetPack $jp), and this build has no PyTorch for it (it has: $(jetson_supported)).
podtorrent: fix: flash a supported JetPack with NVIDIA SDK Manager, or send PodTorrent support the output of: cat $TEGRA_RELEASE"
  echo "$line"
}

preflight_jetson() {
  local fail=0 groups free_kb l4t jp
  ok() { printf '  ok    %s\n' "$*"; }
  bad() { printf '  FAIL  %s\n' "$1"; printf '        fix: %s\n' "$2"; fail=1; }
  [[ -n "${IN_SETUP:-}" ]] || say "checking this machine"   # setup has its own step header
  [[ "$(uname -s)" == Linux ]] || bad "this launcher is for Linux (found $(uname -s))" "use the desktop app on this machine"
  [[ "$(uname -m)" == aarch64 ]] || bad "this build is for ARM64 NVIDIA Jetson (found $(uname -m))" "on an x86_64 machine use the NVIDIA or AMD build"
  if [[ ! -r "$TEGRA_RELEASE" ]]; then
    bad "$TEGRA_RELEASE is missing, so this is not an NVIDIA Jetson with JetPack" "this build is for Jetson AGX Orin with JetPack 6 or 7; flash it with NVIDIA SDK Manager"
  else
    l4t="$(l4t_version)"; jp="$(jetpack_major "${l4t%%.*}")"
    if [[ -n "$(jetson_torch_for "$jp")" ]]; then
      ok "Jetson with L4T $l4t (JetPack $jp)"
    else
      bad "L4T ${l4t:-?} (JetPack $jp) has no PyTorch in this build (it has: $(jetson_supported))" \
          "flash a supported JetPack, or send PodTorrent support the output of: cat $TEGRA_RELEASE"
    fi
  fi
  # CUDA reaches the GPU through /dev/nvmap and /dev/nvhost-* (group video) and, on JetPack 7, the
  # host1x render node /dev/dri/renderD* (group render). Without the render node the video devices
  # open fine but cuInit fails with CUDA error 801, so check video plus the groups owning those nodes.
  local g node list want=(video) missing=()
  for node in "$PF_DRI"/renderD*; do
    [[ -e "$node" ]] || continue
    g="$(stat -c %G "$node" 2>/dev/null)" || continue
    [[ "$g" == root || " ${want[*]} " == *" $g "* ]] || want+=("$g")
  done
  groups=" $(id -nG) "   # this login's groups: what the GPU check and the peer run with
  for g in "${want[@]}"; do [[ "$groups" == *" $g "* ]] || missing+=("$g"); done
  printf -v list '%s and ' "${want[@]}"; list="${list% and }"
  if (( ${#missing[@]} )); then
    # In /etc/group already (usermod ran) but not in this login: a re-login fixes it, not usermod.
    local added=1
    for g in "${missing[@]}"; do [[ " $(id -nG "$(id -un)" 2>/dev/null) " == *" $g "* ]] || added=0; done
    if (( added )); then
      bad "$(id -un) was added to ${missing[*]} after this login started, so CUDA can't reach the GPU yet" \
          "log out and back in; if PodTorrent runs as a background service, reboot so it gets the new groups too"
    else
      bad "$(id -un) is not in: ${missing[*]}, so CUDA can't reach the GPU" \
          "sudo usermod -aG $(IFS=,; echo "${missing[*]}") $(id -un), then log out and back in (or reboot)"
    fi
  else
    ok "$(id -un) is in the $list group$( (( ${#want[@]} > 1 )) && echo s)"
    for node in "$PF_DRI"/renderD*; do
      [[ ! -e "$node" || ( -r "$node" && -w "$node" ) ]] && continue
      bad "$(id -un) can't open $node ($(stat -c '%U:%G %A' "$node" 2>/dev/null)), so CUDA fails with error 801" \
          "its group needs read and write access (ls -l $PF_DRI); check the udev rules that set it"
    done
  fi
  mkdir -p "$DATA"
  if [[ -x "$DATA/venv/bin/python" ]]; then
    ok "PyTorch already installed in $DATA/venv"
  else
    free_kb="$(df -Pk "$DATA" | awk 'NR==2 {print $4}')"
    if (( free_kb / 1024 / 1024 >= 10 )); then
      ok "$(( free_kb / 1024 / 1024 )) GB free in $DATA"
    else
      bad "only $(( free_kb / 1024 / 1024 )) GB free in $DATA; the first run downloads about 10 GB (Python, PyTorch)" \
          "free up space, or put the data on an NVMe drive: echo /big/disk/podtorrent > $DEFAULT_DIR/location"
    fi
  fi
  if (( fail )); then
    say "fix the above and run again (PODTORRENT_SKIP_PREFLIGHT=1 skips these checks)"
    say "$HELP"
    return 1
  fi
  say "this machine is ready"
}

# ---- macOS ----

preflight_macos() {
  local fail=0 os mem_gb free_kb sleep_min
  ok() { printf '  ok    %s\n' "$*"; }
  bad() { printf '  FAIL  %s\n' "$1"; printf '        fix: %s\n' "$2"; fail=1; }
  warn() { printf '  warn  %s\n' "$1"; [[ -z "${2:-}" ]] || printf '        fix: %s\n' "$2"; }
  [[ -n "${IN_SETUP:-}" ]] || say "checking this machine"   # setup has its own step header
  [[ "$(uname -s)" == Darwin ]] || bad "this build is for macOS (found $(uname -s))" "use the Linux headless build on this machine"
  [[ "$(uname -m)" == arm64 ]] || bad "this build needs Apple Silicon (M1 or later; found $(uname -m))" "use an Apple Silicon machine"
  os="$(sw_vers -productVersion 2>/dev/null || echo 0)"
  if version_ge "$os" "$MAC_MIN_OS"; then
    ok "macOS $os"
  else
    bad "macOS $os is older than $MAC_MIN_OS, which MLX needs" "update macOS: softwareupdate --list, then sudo softwareupdate -ia"
  fi
  mem_gb=$(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1024 / 1024 / 1024 ))
  if (( mem_gb >= 16 )); then ok "$mem_gb GB memory"
  else warn "$mem_gb GB memory: a useful slice of a model needs 16 GB or more"; fi

  mkdir -p "$DATA"
  if [[ -x "$DATA/venv/bin/python" ]]; then
    ok "MLX already installed in $DATA/venv"
  else
    free_kb="$(df -Pk "$DATA" | awk 'NR==2 {print $4}')"
    if (( free_kb / 1024 / 1024 >= MAC_NEED_GB )); then
      ok "$(( free_kb / 1024 / 1024 )) GB free in $DATA"
    else
      bad "only $(( free_kb / 1024 / 1024 )) GB free in $DATA; the first run needs about $MAC_NEED_GB GB (Python, MLX)" \
          "free up space, or put the data elsewhere: echo /Volumes/big/podtorrent > $DEFAULT_DIR/location"
    fi
  fi

  # Not failures, but what makes an unattended Mac drop off the swarm.
  if fdesetup status 2>/dev/null | grep -q 'On\.'; then
    warn "FileVault is on: after a restart or power cut this machine waits for someone to unlock it, so PodTorrent can't start" \
         "when you restart it over SSH, use sudo fdesetup authrestart (it unlocks once by itself)"
  fi
  if [[ "$(pmset -g 2>/dev/null | awk '$1 == "autorestart" {print $2}')" != 1 ]]; then
    warn "this machine stays off after a power cut" "sudo pmset -a autorestart 1"
  fi
  sleep_min="$(pmset -g 2>/dev/null | awk '$1 == "sleep" {print $2}')"
  if [[ -n "$sleep_min" && "$sleep_min" != 0 ]]; then
    ok "sleep: the peer keeps this machine awake while it runs (system sleep is set to $sleep_min min)"
  fi

  if (( fail )); then
    say "fix the above and run again (PODTORRENT_SKIP_PREFLIGHT=1 skips these checks)"
    say "$HELP"
    return 1
  fi
  say "this machine is ready"
}

# MLX from the lock (the bundle is the same backend as the Mac app). A no-op once installed.
setup_backend_macos() {
  local v
  [[ -x "$DATA/venv/bin/python" ]] || say "first run: installing Python and MLX into $DATA/venv (about 1 GB, a few minutes)"
  "$UV" sync --frozen --project "$BACKEND" \
    || stuck "installing Python and MLX failed (above); check the network and free disk, then run again"
  v="$("$DATA/venv/bin/python" -c 'import mlx.core as mx; print(mx.__version__)' 2>&1)" \
    || stuck "MLX is installed but doesn't load: $v"
  say "MLX $v"
}

gpu_check_macos() {
  say "checking the GPU with MLX"
  if ! PT_ME="$ME" "$DATA/venv/bin/python" - <<'EOF'
import os, sys
import numpy as np
import mlx.core as mx
if not mx.metal.is_available():
    sys.exit("  FAIL  MLX can't use the GPU (Metal isn't available)\n"
             f"        fix: run {os.environ['PT_ME']} preflight; this needs Apple Silicon and macOS 14 or newer")
rng = np.random.default_rng(0)
a = rng.standard_normal((1024, 1024), dtype=np.float32)
b = rng.standard_normal((1024, 1024), dtype=np.float32)
want = a @ b
try:
    got = (mx.array(a).astype(mx.bfloat16) @ mx.array(b).astype(mx.bfloat16)).astype(mx.float32)
    mx.eval(got)
except Exception as e:
    sys.exit(f"  FAIL  a matrix multiply on the GPU failed: {e}\n"
             "        fix: restart this machine; if it keeps failing, update macOS")
err = float(np.linalg.norm(np.array(got) - want) / np.linalg.norm(want))
if err > 0.02:
    sys.exit(f"  FAIL  the GPU gave a wrong result (relative error {err:.3g})\n"
             "        fix: send engine.log to support")
info = (getattr(mx, "device_info", None) or mx.metal.device_info)()
print(f"  ok    {info.get('device_name', 'GPU')}: matmul matches the CPU (error {err:.2g}), "
      f"{info['max_recommended_working_set_size'] / 2**30:.0f} of {info['memory_size'] / 2**30:.0f} GB usable by the GPU")
EOF
  then
    stuck "the GPU check failed, so the peer won't start"
  fi
}

# ---- processes ----

# detach CMD... &: run CMD as the leader of a new process group (so stop_group stops it and its children).
# Linux has setsid(1); macOS doesn't, so there it's Python's os.setsid (the venv exists by then).
# Only in the background (&): it execs, so $! is CMD's own pid, the group stop_group signals.
detach() {
  if command -v setsid >/dev/null; then
    exec setsid "$@"
  elif [[ -x "$DATA/venv/bin/python" ]]; then
    exec "$DATA/venv/bin/python" -c 'import os, sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' "$@"
  else
    exec "$@"
  fi
}

# ---- Python backend ----

uv_env() {
  export PODTORRENT_HOME="$DATA"
  export UV_PROJECT_ENVIRONMENT="$DATA/venv"
  export UV_PYTHON_PREFERENCE=only-managed
  export PYTHONUNBUFFERED=1   # Python's output in order with the launcher's, in the terminal and engine.log
  export UV_CACHE_DIR="$DATA/uv-cache"
  # uv gives up on a download after 30 s without progress; Python and the wheels are large, and slow
  # links (or a busy GitHub) stall longer than that on the first run.
  export UV_HTTP_TIMEOUT="${UV_HTTP_TIMEOUT:-300}"
  [[ "$DATA" == "$DEFAULT_DIR" ]] || export UV_PYTHON_INSTALL_DIR="$DATA/python"
  [[ -z "${PODTORRENT_NAME:-}" ]] || export PODTORRENT_NAME
  # Jetson: PyTorch comes from NVIDIA's Jetson index, not the lock, so `uv run` must not re-sync it away.
  [[ "$FLAVOR" != jetson ]] || export UV_NO_SYNC=1
  # Jetson: libraries from pip (JetPack 7's CUDA 13 wheels, and extras such as NVPL from jetson-torch.txt)
  # live in the venv, where the loader doesn't look.
  if [[ "$FLAVOR" == jetson ]]; then
    local lib
    for lib in "$DATA"/venv/lib/python3*/site-packages/{nvidia/cu*,nvpl}/lib; do
      [[ -d "$lib" && ":${LD_LIBRARY_PATH:-}:" != *":$lib:"* ]] || continue
      export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}$lib"
    done
  fi
}

# Install Python and ROCm PyTorch (from the gfx1151 index this bundle is locked to) if they aren't yet.
# A no-op once installed; on the first run this downloads several GB.
setup_backend() {
  [[ "$FLAVOR" != jetson ]] || { setup_backend_jetson; return; }
  [[ "$FLAVOR" != macos ]] || { setup_backend_macos; return; }
  [[ -x "$DATA/venv/bin/python" ]] || say "first run: installing Python and ROCm PyTorch into $DATA/venv (several GB, this takes a while)"
  "$UV" sync --frozen --project "$BACKEND" \
    || stuck "installing Python and PyTorch failed (above); check the network and free disk, then run again"
  local hip
  hip="$("$DATA/venv/bin/python" -c 'import torch; print(torch.version.hip or "")' 2>/dev/null || true)"
  if [[ -z "$hip" ]]; then
    stuck "the installed PyTorch is not a ROCm build; remove $DATA/venv and run again"
  fi
  say "PyTorch with ROCm (HIP $hip)"
}

# Jetson: everything from the lock except PyTorch, then the PyTorch for this JetPack (jetson-torch.txt):
# JetPack 6 needs NVIDIA's Jetson build (L4T CUDA 12); JetPack 7 is standard aarch64 CUDA 13, so
# pytorch.org's cu130 wheel. The lock's CPU PyTorch doesn't use the Jetson's GPU.
# Not on a Jetson (CI), the lock's CPU PyTorch stays, and the GPU check blocks the peer as usual.
setup_backend_jetson() {
  local spec idx req extras cuda mark="$DATA/venv/jetson-torch.installed"
  spec="$(jetson_torch)" || exit 1   # says what to do if this JetPack has no index
  [[ -x "$DATA/venv/bin/python" ]] || say "first run: installing Python and PyTorch for Jetson into $DATA/venv (a few GB, this takes a while)"
  # --inexact: keep the Jetson PyTorch and its extras, which aren't in the lock (a plain sync removes them).
  "$UV" sync --frozen --inexact --project "$BACKEND" --no-install-package torch \
    || stuck "installing Python and the backend failed (above); check the network and free disk, then run again"
  if [[ -z "$spec" ]]; then
    say "warning: $TEGRA_RELEASE not found, so this is not a Jetson; installing CPU PyTorch"
    [[ -n "$("$DATA/venv/bin/python" -c 'import torch' 2>/dev/null && echo y)" ]] \
      || "$UV" sync --frozen --project "$BACKEND" \
      || stuck "installing PyTorch failed (above); check the network and free disk, then run again"
    say "PyTorch $("$DATA/venv/bin/python" -c 'import torch; print(torch.__version__)') (CPU)"
    return 0
  fi
  read -r idx req extras <<<"$spec"
  cuda="$("$DATA/venv/bin/python" -c 'import torch; print(torch.version.cuda or "")' 2>/dev/null || true)"
  # Reinstall when there's no CUDA PyTorch yet, or this build's jetson-torch.txt line changed (an update).
  if [[ -z "$cuda" || "$(cat "$mark" 2>/dev/null)" != "$spec" ]]; then
    rm -f "$mark"
    say "installing $req for JetPack from $idx"
    # --index, not --index-url: uv searches --index/--extra-index-url *before* the default index, so with
    # --index-url "$idx" --extra-index-url pypi.org, PyPI's CPU torch would win.
    "$UV" pip install --python "$DATA/venv/bin/python" --index "$idx" --default-index https://pypi.org/simple \
        --index-strategy first-index --reinstall-package torch "$req" \
      || stuck "installing PyTorch for Jetson from $idx failed (above); check the network, then run again"
    if [[ -n "$extras" ]]; then
      # Libraries the wheel links to that neither JetPack nor its dependencies provide; --no-deps.
      # shellcheck disable=SC2086  # extras is a list of requirements
      "$UV" pip install --quiet --python "$DATA/venv/bin/python" --index-url https://pypi.org/simple --no-deps $extras \
        || stuck "installing $extras failed (above); check the network, then run again"
    fi
    uv_env   # library folders from the wheels exist now
    cuda="$("$DATA/venv/bin/python" -c 'import torch; print(torch.version.cuda or "")' 2>&1)" \
      || stuck "PyTorch for Jetson is installed but doesn't load: $cuda"
    [[ -n "$cuda" ]] || stuck "the PyTorch installed from $idx is not a CUDA build; remove $DATA/venv and run again"
    printf '%s\n' "$spec" >"$mark"
  fi
  say "PyTorch for Jetson (CUDA $cuda)"
}

# Run a real computation on the GPU and compare it with the CPU. Without this a broken ROCm setup falls
# back to CPU silently (shard_torch.default_device) and the node slows every chain it is part of.
gpu_check() {
  [[ "$FLAVOR" != macos ]] || { gpu_check_macos; return; }
  say "checking the GPU with PyTorch"
  if ! PT_FLAVOR="$FLAVOR" PT_ME="$ME" "$DATA/venv/bin/python" - <<'EOF'
import os, sys
import torch
if not torch.cuda.is_available():
    sys.exit("  FAIL  PyTorch can't see the GPU (torch.cuda.is_available() is False)\n"
             f"        fix: run {os.environ['PT_ME']} preflight; "
             + ("check you are in the video and render groups (CUDA error 801 means render is missing) and CUDA_VISIBLE_DEVICES is unset" if os.environ["PT_FLAVOR"] == "jetson"
                else "check rocminfo lists gfx1151 and HIP_VISIBLE_DEVICES is unset"))
dev = torch.device("cuda")
a = torch.randn(1024, 1024, generator=torch.Generator().manual_seed(0))
b = torch.randn(1024, 1024, generator=torch.Generator().manual_seed(1))
want = a @ b
try:
    got = (a.to(dev, torch.bfloat16) @ b.to(dev, torch.bfloat16)).float()
    torch.cuda.synchronize(dev)
except Exception as e:
    sys.exit(f"  FAIL  a matrix multiply on the GPU failed: {e}\n"
             "        fix: " + ("check dmesg | grep -i nvgpu, and that JetPack is 6 or 7" if os.environ["PT_FLAVOR"] == "jetson"
                                else "check dmesg | grep amdgpu, and that the kernel is 6.14+"))
err = ((got.cpu() - want).norm() / want.norm()).item()
if err > 0.02:
    sys.exit(f"  FAIL  the GPU gave a wrong result (relative error {err:.3g})\n"
             "        fix: this PyTorch build may not match the GPU; send engine.log to support")
free, total = torch.cuda.mem_get_info(dev)
print(f"  ok    {torch.cuda.get_device_name(dev) or 'GPU'}: matmul matches the CPU "
      f"(error {err:.2g}), {free / 2**30:.0f} of {total / 2**30:.0f} GB GPU memory free")
EOF
  then
    if [[ "${PODTORRENT_ALLOW_CPU:-}" == 1 ]]; then
      say "GPU check failed; continuing on CPU because PODTORRENT_ALLOW_CPU=1 (do not join the network like this)"
      return 0
    fi
    stuck "the GPU check failed, so the peer won't start (it would run on CPU and slow the swarm down)"
  fi
}

# ---- network agent (same rules as the desktop app) ----

# The network's agent URL, from this bundle's backend/podtorrent/endpoints.json (written by CI for
# official builds; see endpoints.example.json). Fails for an unknown network or a build without one.
network_url() {
  case "$1" in production|staging) ;; *) return 1 ;; esac
  "$DATA/venv/bin/python" - "$BACKEND/podtorrent/endpoints.json" "$1" <<'EOF' 2>/dev/null
import json, sys
url = ((json.load(open(sys.argv[1])).get("networks") or {}).get(sys.argv[2]) or {}).get("connect")
print(url) if url else sys.exit(1)
EOF
}

node_up() { (exec 3<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null; }

# Whether the peer's network-manifest.json lists at least one model the swarm fully covers.
covered() {
  "$DATA/venv/bin/python" - "$DATA/network-manifest.json" <<'EOF' 2>/dev/null
import json, sys
sys.exit(0 if json.load(open(sys.argv[1])).get("models") else 1)
EOF
}

network_name() {
  "$DATA/venv/bin/python" -c 'import json,sys; print(json.load(open(sys.argv[1])).get("network","production"))' \
    "$DATA/network.json" 2>/dev/null || echo production
}

AGENT_PID=""
agent_running() { [[ -n "$AGENT_PID" ]] && kill -0 "$AGENT_PID" 2>/dev/null; }

stop_group() {  # stop_group PID: TERM its process group, KILL after 5 s
  local pid="$1" i
  kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || return 0
  for i in $(seq 50); do kill -0 "$pid" 2>/dev/null || return 0; sleep 0.1; done
  kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
}

start_agent() {
  local token url
  [[ -x "$AGENT" ]] || { say "this bundle has no podtorrent-agent; running in the swarm only"; return 1; }
  node_up || return 1
  [[ -s "$DATA/node-token" ]] || return 1
  covered || return 1
  url="$(network_url "$(network_name)")" || { say "this bundle has no $(network_name) network configured; running in the swarm only"; return 1; }
  token="$(tr -d '[:space:]' <"$DATA/node-token")"
  : >"$DATA/agent.log"
  # Its own process group, so stopping it stops tee too. Output goes to journald (stdout) and agent.log.
  PODTORRENT_ENGINE="http://127.0.0.1:$PORT" PODTORRENT_NODE_TOKEN="$token" PODTORRENT_NETWORK="$url" \
    detach "$AGENT" -manifest "$DATA/network-manifest.json" </dev/null > >(tee -a "$DATA/agent.log") 2>&1 &
  AGENT_PID=$!
  say "network agent started (pid $AGENT_PID)"
}

stop_agent() {
  if [[ -n "$AGENT_PID" ]]; then stop_group "$AGENT_PID"; wait "$AGENT_PID" 2>/dev/null || true; AGENT_PID=""; fi
}

# ---- guided setup ----

# The name other peers see: config.json's, else the hostname (the same order the peer uses).
saved_name() {
  "$DATA/venv/bin/python" -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get("name") or "")
except Exception: print("")' "$DATA/config.json"
}

save_name() {
  "$DATA/venv/bin/python" - "$DATA/config.json" "$1" <<'EOF'
import json, sys
p, name = sys.argv[1], sys.argv[2]
try:
    c = json.load(open(p))
except Exception:
    c = {}
c["name"] = name
json.dump(c, open(p, "w"), indent=2)
EOF
}

# ---- the service: systemd --user on Linux, launchd on macOS ----

is_mac() { [[ "$FLAVOR" == macos ]]; }
agent_plist() { echo "$HOME/Library/LaunchAgents/$LABEL.plist"; }
daemon_plist() { echo "/Library/LaunchDaemons/$LABEL.plist"; }
SERVICE_LOG="$DATA/service.log"   # macOS: launchd writes the launcher's output here (Linux: the journal)
# The launchd job as DOMAIN/LABEL, wherever it's loaded: system (--at-boot), gui (a desktop login), or
# user (an SSH login with nobody at the screen).
mac_job() {
  local d
  for d in system "gui/$(id -u)" "user/$(id -u)"; do
    launchctl print "$d/$LABEL" >/dev/null 2>&1 && { echo "$d/$LABEL"; return 0; }
  done
  return 1
}
have_service_manager() { if is_mac; then command -v launchctl >/dev/null; else command -v systemctl >/dev/null; fi; }
service_installed() { if is_mac; then [[ -f "$(agent_plist)" || -f "$(daemon_plist)" ]]; else [[ -f "$(unit_path)" ]]; fi; }
service_active() {
  if is_mac; then
    local job; job="$(mac_job)" || return 1
    launchctl print "$job" 2>/dev/null | grep -q 'state = running'
  else
    command -v systemctl >/dev/null && systemctl --user is-active --quiet "$SERVICE" 2>/dev/null
  fi
}
# Stopped after a failure (launchd retries it every 10 s; this says it isn't up right now).
service_failed() {
  if is_mac; then
    local job out; job="$(mac_job)" || return 1
    out="$(launchctl print "$job" 2>/dev/null)"
    ! grep -q 'state = running' <<<"$out" && grep -Eq 'last exit code = [1-9]' <<<"$out"
  else
    systemctl --user is-failed --quiet "$SERVICE" 2>/dev/null
  fi
}
# mac_stop JOB: SIGTERM the launcher and wait until it has exited. Its trap stops the peer and the agent,
# which run in their own process group; launchctl bootout and kickstart -k don't wait for that and leave
# them running. A clean exit (0) isn't restarted (KeepAlive: SuccessfulExit false).
mac_stop() {
  local job="$1" sudo="" i
  [[ "$job" != system/* ]] || sudo=sudo
  launchctl print "$job" 2>/dev/null | grep -q 'state = running' || return 0
  $sudo launchctl kill TERM "$job" 2>/dev/null || return 0
  for (( i = 0; i < 40; i++ )); do
    launchctl print "$job" 2>/dev/null | grep -q 'state = running' || return 0
    sleep 0.5
  done
}
service_restart() {
  if is_mac; then
    local job; job="$(mac_job)" || return 1
    mac_stop "$job"
    if [[ "$job" == system/* ]]; then sudo launchctl kickstart "$job"; else launchctl kickstart "$job"; fi
  else
    systemctl --user restart "$SERVICE"
  fi
}
service_logs_cmd() { if is_mac; then echo "tail -f $SERVICE_LOG"; else echo "journalctl --user -u podtorrent -f"; fi; }
service_log_tail() {  # service_log_tail LINES
  if is_mac; then tail -n "$1" "$SERVICE_LOG" 2>/dev/null; else journalctl --user -u "$SERVICE" -n "$1" --no-pager 2>/dev/null; fi
}

SETUP_PEER=""
stop_setup_peer() { if [[ -n "$SETUP_PEER" ]]; then stop_group "$SETUP_PEER"; SETUP_PEER=""; fi; }

# wait_for_peer SECONDS: until the peer's API answers. Fails early if the service or the setup peer died.
wait_for_peer() {
  local i
  for (( i = 0; i < $1; i += 2 )); do
    node_up && { (( i == 0 )) || echo; return 0; }
    if [[ -n "$SETUP_PEER" ]] && ! kill -0 "$SETUP_PEER" 2>/dev/null; then echo; return 1; fi
    if [[ -z "$SETUP_PEER" ]] && service_failed; then echo; return 1; fi
    printf '.'
    sleep 2
  done
  echo
  return 1
}

cmd_setup() {
  local name="" network=production use_service=1 join=ask yes=0 pass=() old IN_SETUP=1
  while (( $# )); do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --network) network="$2"; shift 2 ;;
      --no-service) use_service=0; shift ;;
      --join) join=yes; shift ;;
      --no-join) join=no; shift ;;
      --yes) yes=1; pass+=(--yes); shift ;;
      --model|--serve) pass+=("$1" "$2"); shift 2 ;;
      *) die "setup: unknown option $1 (options: --name N --model REPO --serve LO:HI --network production|staging --no-service --join --no-join --yes)" ;;
    esac
  done
  [[ "$network" == production || "$network" == staging ]] || die "network: production or staging"
  [[ -x "$UV" ]] || die "missing $UV: run this from the extracted podtorrent-headless folder"
  if (( use_service )) && ! have_service_manager; then
    say "$(is_mac && echo launchctl || echo systemd) not found: running the peer just for setup (start it later with $ME peer)"
    use_service=0
  fi

  local os_desc mem data_desc="$DATA"
  [[ "$DATA" == "$HOME"/* ]] && data_desc="~${DATA#"$HOME"}"
  if is_mac; then os_desc="macOS $(sw_vers -productVersion 2>/dev/null)"; mem=$(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1073741824 ))
  else os_desc="$(uname -sr)"; mem=$(( $(awk '/MemTotal/ {print $2}' /proc/meminfo 2>/dev/null || echo 0) / 1048576 )); fi
  banner "guided setup: 5 steps, then join the network" \
    "$(hostname -s 2>/dev/null) | $os_desc | $(uname -m) | ${mem} GB" \
    "data: $data_desc" \
    "stuck? $ME doctor  |  Ctrl-C to stop"
  step 1 5 "checking this machine"
  if [[ "${PODTORRENT_SKIP_PREFLIGHT:-}" != 1 ]]; then preflight || exit 1; fi

  step 2 5 "$(is_mac && echo "Python and MLX" || echo "PyTorch and the GPU")"
  uv_env
  setup_backend
  gpu_check

  step 3 5 "this machine's name"
  old="$(saved_name)"
  if [[ -z "$name" ]]; then
    if (( yes )); then
      name="${old:-$(hostname -s)}"
    else
      read -r -p "podtorrent: name other peers see [${old:-$(hostname -s)}] " name
      name="${name:-${old:-$(hostname -s)}}"
    fi
  fi
  name="$(tr -cd '[:print:]' <<<"$name" | cut -c1-40)"
  [[ -n "${name// /}" ]] || die "the name can't be empty"
  save_name "$name"
  say "name: $name"

  step 4 5 "starting the peer"
  if node_up; then
    if [[ "$name" != "$old" ]]; then
      if service_active; then
        say "restarting the service so peers see the new name"
        service_restart
        sleep 2
      else
        say "a peer is already running; restart it to use the new name"
      fi
    else
      say "the peer is already running"
    fi
  elif (( use_service )); then
    cmd_install_service
  else
    PODTORRENT_SKIP_PREFLIGHT=1 detach "$HERE/podtorrent" peer </dev/null >"$DATA/setup-peer.log" 2>&1 &
    SETUP_PEER=$!
    trap 'stop_setup_peer' EXIT
    trap 'stop_setup_peer; exit 130' INT TERM
  fi
  node_up || say "waiting for the peer to come up (the first start measures GPU memory, which can take a minute)"
  if ! wait_for_peer 600; then
    local log="$DATA/engine.log"
    if [[ -n "$SETUP_PEER" ]]; then
      log="$DATA/setup-peer.log"
    elif service_active || service_failed; then
      service_log_tail 20 >&2 || true
      stuck "the peer didn't start; its log is above (all of it: $(service_logs_cmd))"
    fi
    tail -n 20 "$log" >&2 2>/dev/null || true
    stuck "the peer didn't start; its log is above (all of it: $log)"
  fi

  step 5 5 "model and layers"
  "$UV" run --frozen --project "$BACKEND" podtorrent setup --port "$PORT" ${pass[@]+"${pass[@]}"} \
    || stuck "setup didn't finish; run $ME setup again to pick up where it stopped"

  if [[ -f "$DATA/network.json" ]]; then
    say "already joined the PodTorrent network as $(network_name) node; $ME leave to stop"
  elif [[ "$join" == ask && $yes == 0 ]]; then
    local ans
    read -r -p "podtorrent: join the PodTorrent network on $network now? You need a node id and token. [y/N] " ans
    [[ "$ans" =~ ^[Yy] ]] && join=yes
  fi
  if [[ "$join" == yes && ! -f "$DATA/network.json" ]]; then
    cmd_join --network "$network"
  elif [[ ! -f "$DATA/network.json" ]]; then
    say "to join the network later: $ME join --network $network"
  fi

  echo
  if [[ -n "$SETUP_PEER" ]]; then
    say "done. The setup peer stops now; run $ME peer (or $ME install-service) to keep serving"
  elif service_active; then
    if is_mac; then
      say "done. The peer runs as a launchd service and restarts if it stops"
      [[ "$(mac_job)" == system/* ]] || say "to start it at boot with nobody logged in: $ME install-service --at-boot"
    else
      say "done. The peer runs as a service and keeps serving across logouts and reboots (with linger enabled)"
    fi
    say "logs:    $(service_logs_cmd)"
  else
    say "done. The peer you started keeps serving while it runs; $ME install-service keeps it up across logouts"
    say "logs:    $DATA/engine.log"
  fi
  say "watch:   $ME top       (this machine and the swarm, live)"
}

# ---- doctor ----

# t SECONDS CMD...: run with a time limit where coreutils' timeout exists.
t() { local n="$1"; shift; if command -v timeout >/dev/null; then timeout "$n" "$@"; else "$@"; fi; }

# The bundle never carries secrets: the saved node token, and anything that looks like a token or key.
redact() {
  local tok=""
  [[ -s "$DATA/node-token" ]] && tok="$(tr -d '[:space:]' <"$DATA/node-token")"
  if [[ -n "$DOCTOR_PY" ]]; then
    TOK="$tok" "$DOCTOR_PY" - "$1" <<'EOF'
import os, re, sys
from pathlib import Path
tok = os.environ.get("TOK", "")
rules = [
    (re.compile(r"(PODTORRENT_NODE_TOKEN|HF_TOKEN|HUGGING_FACE_HUB_TOKEN)=[^\s\"]+"), r"\1=[REDACTED]"),
    (re.compile(r"(\"?(?:token|api_key|apikey|secret|password)\"?\s*[:=]\s*\"?)[^\",\s]+", re.I), r"\1[REDACTED]"),
    (re.compile(r"(Bearer )[A-Za-z0-9._~+/=-]+"), r"\1[REDACTED]"),
    (re.compile(r"hf_[A-Za-z0-9]{20,}"), "hf_[REDACTED]"),
]
for f in Path(sys.argv[1]).iterdir():
    s = f.read_text(errors="replace")
    if tok:
        s = s.replace(tok, "[REDACTED]")
    for rx, sub in rules:
        s = rx.sub(sub, s)
    f.write_text(s)
EOF
  else
    local f
    for f in "$1"/*; do
      [[ -n "$tok" ]] && { grep -vF "$tok" "$f" >"$f.tmp" || true; mv "$f.tmp" "$f"; }
      sed -E -i \
        -e 's/(PODTORRENT_NODE_TOKEN|HF_TOKEN|HUGGING_FACE_HUB_TOKEN)=[^[:space:]"]+/\1=[REDACTED]/g' \
        -e 's/("?(token|api_key|apikey|secret|password)"?[[:space:]]*[:=][[:space:]]*"?)[^",[:space:]]+/\1[REDACTED]/Ig' \
        -e 's/(Bearer )[A-Za-z0-9._~+\/=-]+/\1[REDACTED]/g' \
        -e 's/hf_[A-Za-z0-9]{20,}/hf_[REDACTED]/g' "$f"
    done
  fi
  if [[ -n "$tok" ]] && grep -rqF "$tok" "$1"; then
    rm -rf "$1"
    die "couldn't remove the node token from the bundle, so it wasn't written"
  fi
}

cmd_doctor() {
  local stamp dir out ok=() bad=() py
  # A diagnostic keeps going whatever fails: every probe below is allowed to fail and is checked explicitly.
  set +e +o pipefail
  stamp="$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$DATA"
  dir="$DATA/doctor-$stamp"
  out="$DATA/podtorrent-doctor-$(hostname -s 2>/dev/null || echo host)-$stamp.tar.gz"
  mkdir -p "$dir"
  uv_env
  py="$DATA/venv/bin/python"
  DOCTOR_PY="$(command -v python3 || true)"
  # macOS: /usr/bin/python3 is a stub that may ask to install the developer tools; the venv's is real.
  ! is_mac || [[ ! -x "$py" ]] || DOCTOR_PY="$py"
  [[ -n "$DOCTOR_PY" || ! -x "$py" ]] || DOCTOR_PY="$py"
  say "checking this machine; this takes up to a minute"

  {
    echo "date: $(date -Is 2>/dev/null || date)"
    echo "bundle: $(basename "$HERE")"
    echo "backend: $(sed -n 's/^version = "\(.*\)"/\1/p' "$BACKEND/pyproject.toml" 2>/dev/null | head -n1)"
    echo "build: $FLAVOR"
    if is_mac; then
      echo "macos: $(sw_vers -productVersion 2>/dev/null) ($(sw_vers -buildVersion 2>/dev/null))"
      echo "chip: $(sysctl -n machdep.cpu.brand_string 2>/dev/null), $(( $(sysctl -n hw.memsize 2>/dev/null || echo 0) / 1073741824 )) GB"
    elif [[ "$FLAVOR" == jetson ]]; then
      echo "l4t: $(head -n1 "$TEGRA_RELEASE" 2>/dev/null || echo "no $TEGRA_RELEASE")"
      echo "torch index: $( (jetson_torch) 2>&1)"
    else
      echo "torch index: $(grep -o 'https://repo.amd.com/rocm[^"]*' "$BACKEND/pyproject.toml" 2>/dev/null | head -n1)"
    fi
    echo "agent: $("$AGENT" -version 2>/dev/null || echo "${AGENT##*/} $([[ -x "$AGENT" ]] && echo present || echo missing)")"
    echo "uname: $(uname -a)"
    cat /etc/os-release 2>/dev/null | grep -E '^(PRETTY_NAME|VERSION_ID)='
    echo "uptime: $(uptime 2>/dev/null)"
    echo "user: $(id)"
    echo "data: $DATA"
    echo "port: $PORT"
  } >"$dir/about.txt" 2>&1

  # (Not a case inside $( ): bash 3.2 misreads its ")" patterns.)
  local checked="kernel, amdgpu, /dev/kfd, groups, disk"
  [[ "$FLAVOR" != jetson ]] || checked="JetPack, groups, disk"
  ! is_mac || checked="macOS, memory, disk"
  if PODTORRENT_PF_KERNEL="$PF_KERNEL" preflight >"$dir/preflight.txt" 2>&1; then
    ok+=("machine checks ($checked)")
  else
    bad+=("machine checks failed: $(grep -m1 FAIL "$dir/preflight.txt" | sed 's/^ *FAIL *//')")
  fi

  if is_mac; then {
    echo "== memory"; vm_stat 2>/dev/null; sysctl hw.memsize iogpu.wired_limit_mb 2>/dev/null
    echo "== disk"; df -h "$DATA" 2>/dev/null
    echo "== data folder"; t 20 du -sh "$DATA"/* 2>/dev/null
    echo "== gpu"; t 30 system_profiler SPDisplaysDataType 2>/dev/null | head -30
    echo "== power"; pmset -g 2>/dev/null; pmset -g assertions 2>/dev/null | grep -iE 'caffeinate|PreventUserIdle|PreventSystemSleep' | head -10
    echo "== filevault"; fdesetup status 2>/dev/null
  } >"$dir/gpu-system.txt" 2>&1; else
  {
    echo "== memory"; free -g 2>/dev/null || vm_stat 2>/dev/null
    echo "== disk"; df -h "$DATA" 2>/dev/null
    echo "== data folder"; t 20 du -sh "$DATA"/* 2>/dev/null
    echo "== amdgpu parameters"
    for f in gttsize vm_size; do echo "$f: $(cat "$PF_SYS/module/amdgpu/parameters/$f" 2>/dev/null || echo ?)"; done
    echo "ttm pages_limit: $(cat "$PF_SYS/module/ttm/parameters/pages_limit" 2>/dev/null || echo ?)"
    echo "== devices"; ls -l /dev/kfd /dev/dri 2>&1
    echo "== kfd topology"; grep -hE 'gfx_target_version|simd_count|mem_banks_count' "$PF_SYS"/class/kfd/kfd/topology/nodes/*/properties 2>/dev/null
    echo "== rocminfo"; t 30 rocminfo 2>&1 | grep -E 'Marketing Name|Name: +gfx|Compute Unit|Size:' | head -40 || echo "rocminfo not installed (not needed: PyTorch brings its own ROCm)"
    [[ "$FLAVOR" != jetson ]] || { echo "== tegrastats"; t 5 tegrastats --interval 1000 2>&1 | head -n 2; echo "== nvpmodel"; t 5 nvpmodel -q 2>&1; }
    echo "== dmesg amdgpu (may need root)"; t 10 dmesg 2>/dev/null | grep -iE 'amdgpu|kfd' | tail -40 || echo "dmesg not readable"
  } >"$dir/gpu-system.txt" 2>&1; fi

  if [[ -x "$py" ]] && is_mac; then
    t 60 "$py" -c 'import mlx.core as mx; print("mlx", mx.__version__, "metal", mx.metal.is_available()); print((getattr(mx, "device_info", None) or mx.metal.device_info)())' >"$dir/torch.txt" 2>&1 || true
  elif [[ -x "$py" ]]; then
    t 120 "$py" - >"$dir/torch.txt" 2>&1 <<'EOF' || true
import torch
print("torch", torch.__version__, "hip", torch.version.hip, "cuda available", torch.cuda.is_available())
if torch.cuda.is_available():
    d = torch.device("cuda")
    p = torch.cuda.get_device_properties(d)
    print("device", torch.cuda.get_device_name(d), "reported GB", round(p.total_memory / 2**30, 1))
    free, total = torch.cuda.mem_get_info(d)
    print("mem_get_info GB free/total", round(free / 2**30, 1), round(total / 2**30, 1))
EOF
  fi
  if [[ -x "$py" ]]; then
    # The real answer, even where PODTORRENT_ALLOW_CPU lets the peer run on the CPU.
    if PODTORRENT_ALLOW_CPU= t 180 "$HERE/podtorrent" gpu-check >>"$dir/torch.txt" 2>&1; then
      ok+=("GPU check: $(grep -m1 '  ok ' "$dir/torch.txt" | sed 's/^ *ok *//')")
    else
      bad+=("GPU check failed: $(grep -m1 FAIL "$dir/torch.txt" | sed 's/^ *FAIL *//')")
    fi
  else
    echo "no venv yet at $DATA/venv" >"$dir/torch.txt"
    bad+=("$(is_mac && echo MLX || echo PyTorch) isn't installed yet: run $ME setup")
  fi

  if node_up; then
    ok+=("peer running on 127.0.0.1:$PORT")
    if [[ -x "$py" ]]; then
      for ep in status api/swarm; do
        t 15 "$py" -c 'import sys,urllib.request
print(urllib.request.urlopen(sys.argv[1], timeout=10).read().decode())' "http://127.0.0.1:$PORT/$ep" \
          >"$dir/${ep//\//-}.json" 2>&1 || true
      done
      t 30 "$UV" run --frozen --project "$BACKEND" podtorrent status >"$dir/status.txt" 2>&1 || true
      if grep -q '"slices": \[\]' "$dir/status.json" 2>/dev/null; then
        bad+=("the peer serves no layers: run $ME setup to pick some")
      fi
    fi
  else
    bad+=("no peer running on 127.0.0.1:$PORT: start it with $ME setup (or $ME peer)")
  fi

  if is_mac; then
    {
      echo "== plist"; cat "$(daemon_plist)" "$(agent_plist)" 2>/dev/null || echo "not installed"
      echo "== job"; t 10 launchctl print "$(mac_job || echo "gui/$(id -u)/$LABEL")" 2>&1 | head -40
      echo "== log"; tail -n 300 "$SERVICE_LOG" 2>&1
    } >"$dir/service.txt" 2>&1
    if service_installed && ! service_active; then
      bad+=("the podtorrent service is installed but not running: $(service_logs_cmd)")
    fi
  elif command -v systemctl >/dev/null; then
    {
      echo "== unit"; cat "$(unit_path)" 2>/dev/null || echo "not installed"
      echo "== status"; t 10 systemctl --user status "$SERVICE" --no-pager 2>&1 | head -20
      echo "== linger: $(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null || echo ?)"
      echo "== journal"; t 20 journalctl --user -u "$SERVICE" -n 300 --no-pager 2>&1
    } >"$dir/service.txt" 2>&1
    if [[ -f "$(unit_path)" ]] && ! service_active; then
      bad+=("the podtorrent service is installed but not running: journalctl --user -u podtorrent")
    fi
  fi

  {
    if [[ -f "$DATA/network.json" ]]; then echo "== network.json"; cat "$DATA/network.json"
    else echo "not joined"; fi
    echo "== node token saved: $([[ -s "$DATA/node-token" ]] && echo yes || echo no)"
    echo "== agent processes"; pgrep -fl "$AGENT" 2>/dev/null || echo none
  } >"$dir/network.txt" 2>&1
  if [[ -f "$DATA/network.json" ]]; then
    if pgrep -f "$AGENT" >/dev/null 2>&1; then
      ok+=("joined $(network_name) and the network agent is running")
    else
      bad+=("joined $(network_name) but the network agent isn't running (it starts once the swarm covers a model)")
    fi
  fi

  for f in engine.log agent.log setup-peer.log config.json; do
    [[ -f "$DATA/$f" ]] && tail -n 2000 "$DATA/$f" >"$dir/$f" 2>/dev/null
  done
  ls -la "$DATA" >"$dir/data-folder.txt" 2>&1

  {
    echo "ok:"; for x in "${ok[@]+"${ok[@]}"}"; do echo "  $x"; done
    echo "problems:"; for x in "${bad[@]+"${bad[@]}"}"; do echo "  $x"; done
  } >"$dir/summary.txt"

  redact "$dir"
  COPYFILE_DISABLE=1 tar -C "$DATA" -czf "$out" "$(basename "$dir")"
  rm -rf "$dir"
  chmod 600 "$out"

  echo
  for x in "${ok[@]+"${ok[@]}"}"; do printf '  ok    %s\n' "$x"; done
  for x in "${bad[@]+"${bad[@]}"}"; do printf '  FAIL  %s\n' "$x"; done
  echo
  say "wrote $out"
  say "send that file to PodTorrent support; it has logs and system details, and no node token or keys"
}

# ---- commands ----

cmd_peer() {
  [[ -x "$UV" ]] || die "missing $UV: run this from the extracted podtorrent-headless folder"
  if [[ "${PODTORRENT_SKIP_PREFLIGHT:-}" != 1 ]]; then preflight || exit 1; fi
  uv_env
  setup_backend
  gpu_check

  : >"$DATA/engine.log"
  say "starting this machine's peer on 127.0.0.1:$PORT (dashboard: http://127.0.0.1:$PORT)"
  detach "$UV" run --frozen --project "$BACKEND" podtorrent peer --port "$PORT" "$@" \
    </dev/null > >(tee -a "$DATA/engine.log") 2>&1 &
  local peer=$! last=0 now
  # macOS: keep the machine from idle sleep (and system sleep on power) for as long as the peer runs.
  if is_mac && command -v caffeinate >/dev/null; then caffeinate -i -s -w "$peer" & fi
  trap 'stop_agent; stop_group '"$peer"'; exit 0' INT TERM
  trap 'stop_agent; stop_group '"$peer" EXIT

  # Like the desktop app: start the agent once joined and the swarm covers a model, at most every 30 s,
  # and stop it whenever the peer's API is down, so it never dials the network without a node.
  while kill -0 "$peer" 2>/dev/null; do
    if agent_running && ! node_up; then
      say "peer API is down; stopping the network agent"
      stop_agent
    elif [[ -f "$DATA/network.json" ]] && ! agent_running; then
      now=$(date +%s)
      if (( now - last >= 30 )) && start_agent; then last=$now; fi
    fi
    sleep 5
  done
  local code=0
  wait "$peer" || code=$?
  say "peer exited (code $code)"
  (( code == 0 )) || say "$HELP"
  exit "$code"
}

cmd_join() {
  local node="" network=production price_in=0 price_out=0 token=""
  while (( $# )); do
    case "$1" in
      --node) node="$2"; shift 2 ;;
      --network) network="$2"; shift 2 ;;
      --price-in) price_in="$2"; shift 2 ;;
      --price-out) price_out="$2"; shift 2 ;;
      *) die "join: unknown option $1 (options: --node ID --network production|staging --price-in N --price-out N)" ;;
    esac
  done
  [[ -n "$node" ]] || read -r -p "node id (letters, digits, - and _): " node
  node="$(tr '[:upper:]' '[:lower:]' <<<"$node")"
  [[ "$node" =~ ^[a-z0-9_-]+$ ]] || die "node id: letters, digits, - and _ only"
  [[ "$network" == production || "$network" == staging ]] || die "network: production or staging"
  [[ "$price_in" =~ ^[0-9]+(\.[0-9]+)?$ && "$price_out" =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "prices must be numbers >= 0"
  mkdir -p "$DATA"
  # Read the token from the terminal without echo (or from stdin when piped), never from the command line.
  if [[ -t 0 ]]; then
    read -r -s -p "node token (Enter keeps the saved one): " token; echo
  else
    read -r token || true
  fi
  token="$(tr -d '[:space:]' <<<"$token")"
  if [[ -n "$token" ]]; then
    (umask 077; printf '%s' "$token" >"$DATA/node-token"); chmod 600 "$DATA/node-token"
  elif [[ ! -s "$DATA/node-token" ]]; then
    die "no saved node token: paste the one you were given"
  fi
  cat >"$DATA/network.json" <<EOF
{
  "node": "$node",
  "network": "$network",
  "tiers": ["interactive", "batch"],
  "price": { "per_mtok_in": $price_in, "per_mtok_out": $price_out }
}
EOF
  say "joined as $node on $network; a running peer connects within 30 s once the swarm covers a model"
}

cmd_leave() {
  rm -f "$DATA/network.json"
  say "left the network; restart the peer (or the service) to stop a running agent now"
}

unit_path() { echo "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$SERVICE"; }

# xml_escape TEXT: for a plist <string>.
xml_escape() { sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' <<<"$1"; }

# Unload the launchd job from wherever it's loaded, and remove its plists. The LaunchDaemon needs sudo.
mac_remove_job() {
  local d
  for d in "gui/$(id -u)" "user/$(id -u)"; do
    launchctl print "$d/$LABEL" >/dev/null 2>&1 || continue
    mac_stop "$d/$LABEL"
    launchctl bootout "$d/$LABEL" 2>/dev/null || true
  done
  if launchctl print "system/$LABEL" >/dev/null 2>&1; then
    mac_stop "system/$LABEL"
    sudo launchctl bootout "system/$LABEL" || true
  fi
  [[ ! -f "$(daemon_plist)" ]] || sudo rm -f "$(daemon_plist)"
  rm -f "$(agent_plist)"
}

cmd_install_service_macos() {
  local at_boot=0 a args="" plist tmp domain user=""
  for a in "$@"; do
    if [[ "$a" == --at-boot ]]; then at_boot=1; else args+="    <string>$(xml_escape "$a")</string>"$'\n'; fi
  done
  (( at_boot )) && user="  <key>UserName</key><string>$(id -un)</string>"$'\n'
  mkdir -p "$DATA"
  tmp="$(mktemp)"
  cat >"$tmp" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key>
  <array>
    <string>$(xml_escape "$HERE/podtorrent")</string>
    <string>peer</string>
${args}  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PODTORRENT_PORT</key><string>$PORT</string>
    <key>HOME</key><string>$(xml_escape "$HOME")</string>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>LANG</key><string>en_US.UTF-8</string>
  </dict>
${user}  <key>WorkingDirectory</key><string>$(xml_escape "$HOME")</string>
  <key>RunAtLoad</key><true/>
  <!-- restart when it fails, not when it's stopped on purpose -->
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>10</integer>
  <!-- the GPU work must not be throttled like a background task -->
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>$(xml_escape "$SERVICE_LOG")</string>
  <key>StandardErrorPath</key><string>$(xml_escape "$SERVICE_LOG")</string>
</dict>
</plist>
PLIST
  plutil -lint -s "$tmp" || { rm -f "$tmp"; stuck "couldn't write the launchd job"; }
  mac_remove_job
  if (( at_boot )); then
    plist="$(daemon_plist)"
    say "installing $plist (sudo asks for your password)"
    if ! sudo install -m 644 -o root -g wheel "$tmp" "$plist"; then rm -f "$tmp"; die "couldn't install $plist"; fi
    rm -f "$tmp"
    sudo launchctl bootstrap system "$plist" || stuck "launchctl couldn't start $plist"
    say "installed $plist and started it: it runs as $(id -un) from boot, with nobody logged in"
  else
    plist="$(agent_plist)"
    mkdir -p "$(dirname "$plist")"
    mv "$tmp" "$plist"
    if launchctl print "gui/$(id -u)" >/dev/null 2>&1; then domain="gui/$(id -u)"; else domain="user/$(id -u)"; fi
    launchctl bootstrap "$domain" "$plist" || stuck "launchctl couldn't start $plist"
    say "installed $plist and started it"
    say "it starts again when you log in; to start it at boot with nobody logged in (the usual choice"
    say "for a machine you reach over SSH): $ME install-service --at-boot"
  fi
  say "logs:    $(service_logs_cmd)"
  say "status:  $ME status"
}

cmd_install_service() {
  ! is_mac || { cmd_install_service_macos "$@"; return; }
  command -v systemctl >/dev/null || die "systemctl not found: this needs systemd"
  local unit; unit="$(unit_path)"
  mkdir -p "$(dirname "$unit")"
  cat >"$unit" <<EOF
[Unit]
Description=PodTorrent peer
After=network-online.target
Wants=network-online.target

[Service]
ExecStart="$HERE/podtorrent" peer${*:+ $*}
Environment=PODTORRENT_PORT=$PORT
Restart=on-failure
RestartSec=10
# The first start installs ROCm PyTorch (several GB).
TimeoutStartSec=infinity
KillMode=control-group

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload
  systemctl --user enable --now "$SERVICE"
  say "installed $unit and started it"
  say "logs:    journalctl --user -u podtorrent -f"
  say "status:  systemctl --user status podtorrent"
  if [[ "$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null)" != yes ]]; then
    say "to keep the peer running after you log out and start it at boot, run once:"
    say "  sudo loginctl enable-linger $(id -un)"
  fi
}

cmd_uninstall_service() {
  if is_mac; then mac_remove_job; say "removed the podtorrent service"; return; fi
  systemctl --user disable --now "$SERVICE" 2>/dev/null || true
  rm -f "$(unit_path)"
  systemctl --user daemon-reload 2>/dev/null || true
  say "removed the podtorrent service"
}

usage() { sed -n '2,20p' "${BASH_SOURCE[0]}" | sed -e 's/^# \{0,1\}//' -e "s|\./podtorrent|$ME|g"; }

case "${1:-}" in
  setup) shift; cmd_setup "$@" ;;
  peer) shift; cmd_peer "$@" ;;
  join) shift; cmd_join "$@" ;;
  leave) cmd_leave ;;
  preflight) preflight ;;
  gpu-check) uv_env; setup_backend; gpu_check ;;
  doctor) cmd_doctor ;;
  install-service) shift; cmd_install_service "$@" ;;
  uninstall-service) cmd_uninstall_service ;;
  # The engine's own commands, against the running peer: models, swarm, serve, unserve, pod, video.
  top|status|models|swarm|serve|unserve|pod|video)
    uv_env
    [[ -x "$DATA/venv/bin/python" ]] || die "run $ME setup (or $ME peer) first"
    exec "$UV" run --frozen --project "$BACKEND" podtorrent "$@" ;;
  -h|--help|help|"") usage ;;
  *) usage; exit 2 ;;
esac
