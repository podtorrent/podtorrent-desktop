#!/usr/bin/env bash
# PodTorrent headless launcher for Linux AMD (Ryzen AI Max / Strix Halo, gfx1151). No GUI needed.
#
#   ./podtorrent setup              guided first run: checks, GPU, name, model and layers, service, network
#   ./podtorrent peer               preflight, install ROCm PyTorch on first run, run this machine's peer,
#                                   and keep it on the PodTorrent network once joined
#   ./podtorrent join               join the PodTorrent network as a node (asks for the node token)
#   ./podtorrent leave              stop serving the network (the peer keeps running in the swarm)
#   ./podtorrent preflight          check the kernel, GPU driver and permissions only
#   ./podtorrent gpu-check          run a computation on the GPU with the installed PyTorch
#   ./podtorrent doctor             check everything and write a bundle to send us (no token in it)
#   ./podtorrent install-service    run the peer as a systemd --user service (survives logout and reboot)
#   ./podtorrent uninstall-service  remove that service
#   ./podtorrent top                live view of this machine and the swarm (status: once; status --json)
#   ./podtorrent models | swarm | serve | unserve | pod   the engine's commands, against the running peer
#
# Data (models, venv, logs) lives in ~/.podtorrent, or the folder named in ~/.podtorrent/location,
# the same place the desktop app uses. Extra arguments after `peer` go to `podtorrent peer`.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
BACKEND="$HERE/backend"
UV="$BACKEND/uv"
AGENT="$BACKEND/podtorrent-agent"
PORT="${PODTORRENT_PORT:-27183}"
DEFAULT_DIR="$HOME/.podtorrent"
SERVICE=podtorrent.service
MIN_KERNEL=6.14
# ROCm PyTorch plus Python and the venv come to about 15 GB; leave room for the cache too.
NEED_GB=25

# How the user runs this: `podtorrent` when it is the command on PATH (install.sh puts it there),
# else ./podtorrent from the unpacked folder. Messages and help say it that way; Python reads PODTORRENT_CMD.
ME=./podtorrent
if [[ "$(readlink -f "$(command -v podtorrent 2>/dev/null)" 2>/dev/null)" == "$(readlink -f "${BASH_SOURCE[0]}")" ]]; then
  ME=podtorrent
fi
export PODTORRENT_CMD="$ME"

say() { printf 'podtorrent: %s\n' "$*"; }
die() { printf 'podtorrent: %s\n' "$*" >&2; exit 1; }
# A failure the user can't fix from the message alone: point them at doctor.
HELP="if this keeps happening, run $ME doctor and send us the file it writes"
stuck() { printf 'podtorrent: %s\npodtorrent: %s\n' "$*" "$HELP" >&2; exit 1; }

data_dir() {
  local loc
  if [[ -f "$DEFAULT_DIR/location" ]] && loc="$(head -n1 "$DEFAULT_DIR/location")" && [[ "$loc" == /* ]]; then
    printf '%s\n' "$loc"
  else
    printf '%s\n' "$DEFAULT_DIR"
  fi
}
DATA="$(data_dir)"

# ---- preflight ----

# version_ge A B: A >= B for dotted versions (only the leading numeric parts count).
version_ge() {
  local a b i
  IFS=. read -r -a a <<<"${1%%[!0-9.]*}"
  IFS=. read -r -a b <<<"$2"
  for i in 0 1 2; do
    (( ${a[i]:-0} > ${b[i]:-0} )) && return 0
    (( ${a[i]:-0} < ${b[i]:-0} )) && return 1
  done
  return 0
}

# Paths are overridable so the checks can be tested on another machine.
PF_KERNEL="${PODTORRENT_PF_KERNEL:-$(uname -r)}"
PF_SYS="${PODTORRENT_PF_SYS:-/sys}"
PF_KFD="${PODTORRENT_PF_KFD:-/dev/kfd}"

preflight() {
  local fail=0 groups g missing=() free_kb
  ok() { printf '  ok    %s\n' "$*"; }
  bad() { printf '  FAIL  %s\n' "$1"; printf '        fix: %s\n' "$2"; fail=1; }
  warn() { printf '  warn  %s\n' "$*"; }
  say "checking this machine"

  [[ "$(uname -s)" == Linux ]] || bad "this launcher is for Linux (found $(uname -s))" "use the desktop app on this machine"
  [[ "$(uname -m)" == x86_64 ]] || bad "this build is for x86_64 (found $(uname -m))" "use a Ryzen AI Max (Strix Halo) machine"

  if version_ge "$PF_KERNEL" "$MIN_KERNEL"; then
    ok "kernel $PF_KERNEL"
  else
    bad "kernel $PF_KERNEL is older than $MIN_KERNEL, which Strix Halo needs for ROCm" \
        "install a $MIN_KERNEL+ kernel (Ubuntu 24.04: sudo apt install linux-generic-hwe-24.04, or Ubuntu 25.04+), then reboot"
  fi

  if [[ -d "$PF_SYS/module/amdgpu" ]]; then
    ok "amdgpu driver loaded"
  else
    bad "the amdgpu kernel driver is not loaded" \
        "sudo modprobe amdgpu (and check dmesg | grep amdgpu); if it is blacklisted, remove the blacklist and reboot"
  fi

  if [[ -r "$PF_KFD" && -w "$PF_KFD" ]]; then
    ok "$PF_KFD is accessible"
  elif [[ -e "$PF_KFD" ]]; then
    bad "$PF_KFD exists but $(id -un) can't open it" "add yourself to the render and video groups (below), then log out and back in"
  else
    bad "$PF_KFD is missing, so ROCm can't reach the GPU" "load amdgpu with a $MIN_KERNEL+ kernel; /dev/kfd appears with it"
  fi

  groups=" $(id -nG) "
  for g in video render; do [[ "$groups" == *" $g "* ]] || missing+=("$g"); done
  if (( ${#missing[@]} == 0 )); then
    ok "$(id -un) is in the video and render groups"
  else
    bad "$(id -un) is not in: ${missing[*]}" \
        "sudo usermod -aG video,render $(id -un), then log out and back in (or reboot)"
  fi

  # Informational: the build's PyTorch wheels are for gfx1151 only.
  if ! grep -qs 'gfx_target_version 110501' "$PF_SYS"/class/kfd/kfd/topology/nodes/*/properties; then
    warn "no gfx1151 GPU found in the KFD topology; this build's PyTorch is for Ryzen AI Max (Radeon 8050S/8060S)"
  fi

  mkdir -p "$DATA"
  if [[ -x "$DATA/venv/bin/python" ]]; then
    ok "PyTorch already installed in $DATA/venv"
  else
    free_kb="$(df -Pk "$DATA" | awk 'NR==2 {print $4}')"
    if (( free_kb / 1024 / 1024 >= NEED_GB )); then
      ok "$(( free_kb / 1024 / 1024 )) GB free in $DATA"
    else
      bad "only $(( free_kb / 1024 / 1024 )) GB free in $DATA; the first run downloads about $NEED_GB GB (ROCm PyTorch)" \
          "free up space, or put the data elsewhere: echo /big/disk/podtorrent > $DEFAULT_DIR/location"
    fi
  fi

  if (( fail )); then
    say "fix the above and run again (PODTORRENT_SKIP_PREFLIGHT=1 skips these checks)"
    say "$HELP"
    return 1
  fi
  say "this machine is ready"
}

# ---- Python backend ----

uv_env() {
  export PODTORRENT_HOME="$DATA"
  export UV_PROJECT_ENVIRONMENT="$DATA/venv"
  export UV_PYTHON_PREFERENCE=only-managed
  export PYTHONUNBUFFERED=1   # Python's output in order with the launcher's, in the terminal and engine.log
  export UV_CACHE_DIR="$DATA/uv-cache"
  [[ "$DATA" == "$DEFAULT_DIR" ]] || export UV_PYTHON_INSTALL_DIR="$DATA/python"
  [[ -z "${PODTORRENT_NAME:-}" ]] || export PODTORRENT_NAME
}

# Install Python and ROCm PyTorch (from the gfx1151 index this bundle is locked to) if they aren't yet.
# A no-op once installed; on the first run this downloads several GB.
setup_backend() {
  [[ -x "$DATA/venv/bin/python" ]] || say "first run: installing Python and ROCm PyTorch into $DATA/venv (several GB, this takes a while)"
  "$UV" sync --frozen --project "$BACKEND" \
    || stuck "installing Python and PyTorch failed (above); check the network and free disk, then run again"
  local hip
  hip="$("$DATA/venv/bin/python" -c 'import torch; print(torch.version.hip or "")' 2>/dev/null || true)"
  if [[ -z "$hip" ]]; then
    stuck "the installed PyTorch is not a ROCm build; remove $DATA/venv and run again"
  fi
  say "PyTorch with ROCm (HIP $hip)"
}

# Run a real computation on the GPU and compare it with the CPU. Without this a broken ROCm setup falls
# back to CPU silently (shard_torch.default_device) and the node slows every chain it is part of.
gpu_check() {
  say "checking the GPU with PyTorch"
  if ! "$DATA/venv/bin/python" - <<'EOF'
import sys
import torch
if not torch.cuda.is_available():
    sys.exit("  FAIL  PyTorch can't see the GPU (torch.cuda.is_available() is False)\n"
             "        fix: run $ME preflight; check rocminfo lists gfx1151 and HIP_VISIBLE_DEVICES is unset")
dev = torch.device("cuda")
a = torch.randn(1024, 1024, generator=torch.Generator().manual_seed(0))
b = torch.randn(1024, 1024, generator=torch.Generator().manual_seed(1))
want = a @ b
try:
    got = (a.to(dev, torch.bfloat16) @ b.to(dev, torch.bfloat16)).float()
    torch.cuda.synchronize(dev)
except Exception as e:
    sys.exit(f"  FAIL  a matrix multiply on the GPU failed: {e}\n"
             "        fix: check dmesg | grep amdgpu, and that the kernel is 6.14+")
err = ((got.cpu() - want).norm() / want.norm()).item()
if err > 0.02:
    sys.exit(f"  FAIL  the GPU gave a wrong result (relative error {err:.3g})\n"
             "        fix: this PyTorch build may not match the GPU; send engine.log to support")
free, total = torch.cuda.mem_get_info(dev)
print(f"  ok    {torch.cuda.get_device_name(dev) or 'AMD GPU'}: matmul matches the CPU "
      f"(error {err:.2g}), {free / 2**30:.0f} of {total / 2**30:.0f} GB GPU memory free")
EOF
  then
    if [[ "${PODTORRENT_ALLOW_CPU:-}" == 1 ]]; then
      say "GPU check failed; continuing on CPU because PODTORRENT_ALLOW_CPU=1 (do not join the network like this)"
      return 0
    fi
    stuck "the GPU check failed, so the peer won't start (it would run on CPU and slow the swarm down)"
  fi
}

# ---- network agent (same rules as the desktop app) ----

# The network's agent URL, from this bundle's backend/podtorrent/endpoints.json (written by CI for
# official builds; see endpoints.example.json). Fails for an unknown network or a build without one.
network_url() {
  case "$1" in production|staging) ;; *) return 1 ;; esac
  "$DATA/venv/bin/python" - "$BACKEND/podtorrent/endpoints.json" "$1" <<'EOF' 2>/dev/null
import json, sys
url = ((json.load(open(sys.argv[1])).get("networks") or {}).get(sys.argv[2]) or {}).get("connect")
print(url) if url else sys.exit(1)
EOF
}

node_up() { (exec 3<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null; }

# Whether the peer's network-manifest.json lists at least one model the swarm fully covers.
covered() {
  "$DATA/venv/bin/python" - "$DATA/network-manifest.json" <<'EOF' 2>/dev/null
import json, sys
sys.exit(0 if json.load(open(sys.argv[1])).get("models") else 1)
EOF
}

network_name() {
  "$DATA/venv/bin/python" -c 'import json,sys; print(json.load(open(sys.argv[1])).get("network","production"))' \
    "$DATA/network.json" 2>/dev/null || echo production
}

AGENT_PID=""
agent_running() { [[ -n "$AGENT_PID" ]] && kill -0 "$AGENT_PID" 2>/dev/null; }

stop_group() {  # stop_group PID: TERM its process group, KILL after 5 s
  local pid="$1" i
  kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || return 0
  for i in $(seq 50); do kill -0 "$pid" 2>/dev/null || return 0; sleep 0.1; done
  kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
}

start_agent() {
  local token url
  [[ -x "$AGENT" ]] || { say "this bundle has no podtorrent-agent; running in the swarm only"; return 1; }
  node_up || return 1
  [[ -s "$DATA/node-token" ]] || return 1
  covered || return 1
  url="$(network_url "$(network_name)")" || { say "this bundle has no $(network_name) network configured; running in the swarm only"; return 1; }
  token="$(tr -d '[:space:]' <"$DATA/node-token")"
  : >"$DATA/agent.log"
  # Its own process group, so stopping it stops tee too. Output goes to journald (stdout) and agent.log.
  PODTORRENT_ENGINE="http://127.0.0.1:$PORT" PODTORRENT_NODE_TOKEN="$token" PODTORRENT_NETWORK="$url" \
    setsid "$AGENT" -manifest "$DATA/network-manifest.json" </dev/null > >(tee -a "$DATA/agent.log") 2>&1 &
  AGENT_PID=$!
  say "network agent started (pid $AGENT_PID)"
}

stop_agent() {
  if [[ -n "$AGENT_PID" ]]; then stop_group "$AGENT_PID"; wait "$AGENT_PID" 2>/dev/null || true; AGENT_PID=""; fi
}

# ---- guided setup ----

# The name other peers see: config.json's, else the hostname (the same order the peer uses).
saved_name() {
  "$DATA/venv/bin/python" -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get("name") or "")
except Exception: print("")' "$DATA/config.json"
}

save_name() {
  "$DATA/venv/bin/python" - "$DATA/config.json" "$1" <<'EOF'
import json, sys
p, name = sys.argv[1], sys.argv[2]
try:
    c = json.load(open(p))
except Exception:
    c = {}
c["name"] = name
json.dump(c, open(p, "w"), indent=2)
EOF
}

service_active() { command -v systemctl >/dev/null && systemctl --user is-active --quiet "$SERVICE" 2>/dev/null; }

SETUP_PEER=""
stop_setup_peer() { if [[ -n "$SETUP_PEER" ]]; then stop_group "$SETUP_PEER"; SETUP_PEER=""; fi; }

# wait_for_peer SECONDS: until the peer's API answers. Fails early if the service or the setup peer died.
wait_for_peer() {
  local i
  for (( i = 0; i < $1; i += 2 )); do
    node_up && { (( i == 0 )) || echo; return 0; }
    if [[ -n "$SETUP_PEER" ]] && ! kill -0 "$SETUP_PEER" 2>/dev/null; then echo; return 1; fi
    if [[ -z "$SETUP_PEER" ]] && systemctl --user is-failed --quiet "$SERVICE" 2>/dev/null; then echo; return 1; fi
    printf '.'
    sleep 2
  done
  echo
  return 1
}

cmd_setup() {
  local name="" network=production use_service=1 join=ask yes=0 pass=() old
  while (( $# )); do
    case "$1" in
      --name) name="$2"; shift 2 ;;
      --network) network="$2"; shift 2 ;;
      --no-service) use_service=0; shift ;;
      --join) join=yes; shift ;;
      --no-join) join=no; shift ;;
      --yes) yes=1; pass+=(--yes); shift ;;
      --model|--serve) pass+=("$1" "$2"); shift 2 ;;
      *) die "setup: unknown option $1 (options: --name N --model REPO --serve LO:HI --network production|staging --no-service --join --no-join --yes)" ;;
    esac
  done
  [[ "$network" == production || "$network" == staging ]] || die "network: production or staging"
  [[ -x "$UV" ]] || die "missing $UV: run this from the extracted podtorrent-headless folder"
  if (( use_service )) && ! command -v systemctl >/dev/null; then
    say "systemd not found: running the peer just for setup (start it later with $ME peer)"
    use_service=0
  fi

  say "step 1/5: checking this machine"
  if [[ "${PODTORRENT_SKIP_PREFLIGHT:-}" != 1 ]]; then preflight || exit 1; fi

  say "step 2/5: PyTorch and the GPU"
  uv_env
  setup_backend
  gpu_check

  say "step 3/5: this machine's name"
  old="$(saved_name)"
  if [[ -z "$name" ]]; then
    if (( yes )); then
      name="${old:-$(hostname -s)}"
    else
      read -r -p "podtorrent: name other peers see [${old:-$(hostname -s)}] " name
      name="${name:-${old:-$(hostname -s)}}"
    fi
  fi
  name="$(tr -cd '[:print:]' <<<"$name" | cut -c1-40)"
  [[ -n "${name// /}" ]] || die "the name can't be empty"
  save_name "$name"
  say "name: $name"

  say "step 4/5: starting the peer"
  if node_up; then
    if [[ "$name" != "$old" ]]; then
      if service_active; then
        say "restarting the service so peers see the new name"
        systemctl --user restart "$SERVICE"
        sleep 2
      else
        say "a peer is already running; restart it to use the new name"
      fi
    else
      say "the peer is already running"
    fi
  elif (( use_service )); then
    cmd_install_service
  else
    PODTORRENT_SKIP_PREFLIGHT=1 setsid "$HERE/podtorrent" peer </dev/null >"$DATA/setup-peer.log" 2>&1 &
    SETUP_PEER=$!
    trap 'stop_setup_peer' EXIT
    trap 'stop_setup_peer; exit 130' INT TERM
  fi
  node_up || say "waiting for the peer to come up (the first start measures GPU memory, which can take a minute)"
  if ! wait_for_peer 600; then
    local log="$DATA/engine.log"
    if [[ -n "$SETUP_PEER" ]]; then
      log="$DATA/setup-peer.log"
    elif service_active || systemctl --user is-failed --quiet "$SERVICE" 2>/dev/null; then
      journalctl --user -u "$SERVICE" -n 20 --no-pager >&2 2>/dev/null || true
      stuck "the peer didn't start; its log is above (all of it: journalctl --user -u podtorrent)"
    fi
    tail -n 20 "$log" >&2 2>/dev/null || true
    stuck "the peer didn't start; its log is above (all of it: $log)"
  fi

  say "step 5/5: model and layers"
  "$UV" run --frozen --project "$BACKEND" podtorrent setup --port "$PORT" ${pass[@]+"${pass[@]}"} \
    || stuck "setup didn't finish; run $ME setup again to pick up where it stopped"

  if [[ -f "$DATA/network.json" ]]; then
    say "already joined the PodTorrent network as $(network_name) node; $ME leave to stop"
  elif [[ "$join" == ask && $yes == 0 ]]; then
    local ans
    read -r -p "podtorrent: join the PodTorrent network on $network now? You need a node id and token. [y/N] " ans
    [[ "$ans" =~ ^[Yy] ]] && join=yes
  fi
  if [[ "$join" == yes && ! -f "$DATA/network.json" ]]; then
    cmd_join --network "$network"
  elif [[ ! -f "$DATA/network.json" ]]; then
    say "to join the network later: $ME join --network $network"
  fi

  echo
  if [[ -n "$SETUP_PEER" ]]; then
    say "done. The setup peer stops now; run $ME peer (or $ME install-service) to keep serving"
  elif service_active; then
    say "done. The peer runs as a service and keeps serving across logouts and reboots (with linger enabled)"
    say "logs:    journalctl --user -u podtorrent -f"
  else
    say "done. The peer you started keeps serving while it runs; $ME install-service keeps it up across logouts"
    say "logs:    $DATA/engine.log"
  fi
  say "watch:   $ME top       (this machine and the swarm, live)"
}

# ---- doctor ----

# t SECONDS CMD...: run with a time limit where coreutils' timeout exists.
t() { local n="$1"; shift; if command -v timeout >/dev/null; then timeout "$n" "$@"; else "$@"; fi; }

# The bundle never carries secrets: the saved node token, and anything that looks like a token or key.
redact() {
  local tok=""
  [[ -s "$DATA/node-token" ]] && tok="$(tr -d '[:space:]' <"$DATA/node-token")"
  if [[ -n "$DOCTOR_PY" ]]; then
    TOK="$tok" "$DOCTOR_PY" - "$1" <<'EOF'
import os, re, sys
from pathlib import Path
tok = os.environ.get("TOK", "")
rules = [
    (re.compile(r"(PODTORRENT_NODE_TOKEN|HF_TOKEN|HUGGING_FACE_HUB_TOKEN)=[^\s\"]+"), r"\1=[REDACTED]"),
    (re.compile(r"(\"?(?:token|api_key|apikey|secret|password)\"?\s*[:=]\s*\"?)[^\",\s]+", re.I), r"\1[REDACTED]"),
    (re.compile(r"(Bearer )[A-Za-z0-9._~+/=-]+"), r"\1[REDACTED]"),
    (re.compile(r"hf_[A-Za-z0-9]{20,}"), "hf_[REDACTED]"),
]
for f in Path(sys.argv[1]).iterdir():
    s = f.read_text(errors="replace")
    if tok:
        s = s.replace(tok, "[REDACTED]")
    for rx, sub in rules:
        s = rx.sub(sub, s)
    f.write_text(s)
EOF
  else
    local f
    for f in "$1"/*; do
      [[ -n "$tok" ]] && { grep -vF "$tok" "$f" >"$f.tmp" || true; mv "$f.tmp" "$f"; }
      sed -E -i \
        -e 's/(PODTORRENT_NODE_TOKEN|HF_TOKEN|HUGGING_FACE_HUB_TOKEN)=[^[:space:]"]+/\1=[REDACTED]/g' \
        -e 's/("?(token|api_key|apikey|secret|password)"?[[:space:]]*[:=][[:space:]]*"?)[^",[:space:]]+/\1[REDACTED]/Ig' \
        -e 's/(Bearer )[A-Za-z0-9._~+\/=-]+/\1[REDACTED]/g' \
        -e 's/hf_[A-Za-z0-9]{20,}/hf_[REDACTED]/g' "$f"
    done
  fi
  if [[ -n "$tok" ]] && grep -rqF "$tok" "$1"; then
    rm -rf "$1"
    die "couldn't remove the node token from the bundle, so it wasn't written"
  fi
}

cmd_doctor() {
  local stamp dir out ok=() bad=() py
  # A diagnostic keeps going whatever fails: every probe below is allowed to fail and is checked explicitly.
  set +e +o pipefail
  stamp="$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$DATA"
  dir="$DATA/doctor-$stamp"
  out="$DATA/podtorrent-doctor-$(hostname -s 2>/dev/null || echo host)-$stamp.tar.gz"
  mkdir -p "$dir"
  uv_env
  py="$DATA/venv/bin/python"
  DOCTOR_PY="$(command -v python3 || true)"
  [[ -n "$DOCTOR_PY" || ! -x "$py" ]] || DOCTOR_PY="$py"
  say "checking this machine; this takes up to a minute"

  {
    echo "date: $(date -Is 2>/dev/null || date)"
    echo "bundle: $(basename "$HERE")"
    echo "backend: $(sed -n 's/^version = "\(.*\)"/\1/p' "$BACKEND/pyproject.toml" 2>/dev/null | head -n1)"
    echo "torch index: $(grep -o 'https://repo.amd.com/rocm[^"]*' "$BACKEND/pyproject.toml" 2>/dev/null | head -n1)"
    echo "agent: $("$AGENT" -version 2>/dev/null || echo "${AGENT##*/} $([[ -x "$AGENT" ]] && echo present || echo missing)")"
    echo "uname: $(uname -a)"
    cat /etc/os-release 2>/dev/null | grep -E '^(PRETTY_NAME|VERSION_ID)='
    echo "uptime: $(uptime 2>/dev/null)"
    echo "user: $(id)"
    echo "data: $DATA"
    echo "port: $PORT"
  } >"$dir/about.txt" 2>&1

  if PODTORRENT_PF_KERNEL="$PF_KERNEL" preflight >"$dir/preflight.txt" 2>&1; then
    ok+=("machine checks (kernel, amdgpu, /dev/kfd, groups, disk)")
  else
    bad+=("machine checks failed: $(grep -m1 FAIL "$dir/preflight.txt" | sed 's/^ *FAIL *//')")
  fi

  {
    echo "== memory"; free -g 2>/dev/null || vm_stat 2>/dev/null
    echo "== disk"; df -h "$DATA" 2>/dev/null
    echo "== data folder"; t 20 du -sh "$DATA"/* 2>/dev/null
    echo "== amdgpu parameters"
    for f in gttsize vm_size; do echo "$f: $(cat "$PF_SYS/module/amdgpu/parameters/$f" 2>/dev/null || echo ?)"; done
    echo "ttm pages_limit: $(cat "$PF_SYS/module/ttm/parameters/pages_limit" 2>/dev/null || echo ?)"
    echo "== devices"; ls -l /dev/kfd /dev/dri 2>&1
    echo "== kfd topology"; grep -hE 'gfx_target_version|simd_count|mem_banks_count' "$PF_SYS"/class/kfd/kfd/topology/nodes/*/properties 2>/dev/null
    echo "== rocminfo"; t 30 rocminfo 2>&1 | grep -E 'Marketing Name|Name: +gfx|Compute Unit|Size:' | head -40 || echo "rocminfo not installed (not needed: PyTorch brings its own ROCm)"
    echo "== dmesg amdgpu (may need root)"; t 10 dmesg 2>/dev/null | grep -iE 'amdgpu|kfd' | tail -40 || echo "dmesg not readable"
  } >"$dir/gpu-system.txt" 2>&1

  if [[ -x "$py" ]]; then
    t 120 "$py" - >"$dir/torch.txt" 2>&1 <<'EOF' || true
import torch
print("torch", torch.__version__, "hip", torch.version.hip, "cuda available", torch.cuda.is_available())
if torch.cuda.is_available():
    d = torch.device("cuda")
    p = torch.cuda.get_device_properties(d)
    print("device", torch.cuda.get_device_name(d), "reported GB", round(p.total_memory / 2**30, 1))
    free, total = torch.cuda.mem_get_info(d)
    print("mem_get_info GB free/total", round(free / 2**30, 1), round(total / 2**30, 1))
EOF
    # The real answer, even where PODTORRENT_ALLOW_CPU lets the peer run on the CPU.
    if PODTORRENT_ALLOW_CPU= t 180 "$HERE/podtorrent" gpu-check >>"$dir/torch.txt" 2>&1; then
      ok+=("GPU check: $(grep -m1 '  ok ' "$dir/torch.txt" | sed 's/^ *ok *//')")
    else
      bad+=("GPU check failed: $(grep -m1 FAIL "$dir/torch.txt" | sed 's/^ *FAIL *//')")
    fi
  else
    echo "no venv yet at $DATA/venv" >"$dir/torch.txt"
    bad+=("PyTorch isn't installed yet: run $ME setup")
  fi

  if node_up; then
    ok+=("peer running on 127.0.0.1:$PORT")
    if [[ -x "$py" ]]; then
      for ep in status api/swarm; do
        t 15 "$py" -c 'import sys,urllib.request
print(urllib.request.urlopen(sys.argv[1], timeout=10).read().decode())' "http://127.0.0.1:$PORT/$ep" \
          >"$dir/${ep//\//-}.json" 2>&1 || true
      done
      t 30 "$UV" run --frozen --project "$BACKEND" podtorrent status >"$dir/status.txt" 2>&1 || true
      if grep -q '"slices": \[\]' "$dir/status.json" 2>/dev/null; then
        bad+=("the peer serves no layers: run $ME setup to pick some")
      fi
    fi
  else
    bad+=("no peer running on 127.0.0.1:$PORT: start it with $ME setup (or $ME peer)")
  fi

  if command -v systemctl >/dev/null; then
    {
      echo "== unit"; cat "$(unit_path)" 2>/dev/null || echo "not installed"
      echo "== status"; t 10 systemctl --user status "$SERVICE" --no-pager 2>&1 | head -20
      echo "== linger: $(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null || echo ?)"
      echo "== journal"; t 20 journalctl --user -u "$SERVICE" -n 300 --no-pager 2>&1
    } >"$dir/service.txt" 2>&1
    if [[ -f "$(unit_path)" ]] && ! service_active; then
      bad+=("the podtorrent service is installed but not running: journalctl --user -u podtorrent")
    fi
  fi

  {
    if [[ -f "$DATA/network.json" ]]; then echo "== network.json"; cat "$DATA/network.json"
    else echo "not joined"; fi
    echo "== node token saved: $([[ -s "$DATA/node-token" ]] && echo yes || echo no)"
    echo "== agent processes"; pgrep -fl "$AGENT" 2>/dev/null || echo none
  } >"$dir/network.txt" 2>&1
  if [[ -f "$DATA/network.json" ]]; then
    if pgrep -f "$AGENT" >/dev/null 2>&1; then
      ok+=("joined $(network_name) and the network agent is running")
    else
      bad+=("joined $(network_name) but the network agent isn't running (it starts once the swarm covers a model)")
    fi
  fi

  for f in engine.log agent.log setup-peer.log config.json; do
    [[ -f "$DATA/$f" ]] && tail -n 2000 "$DATA/$f" >"$dir/$f" 2>/dev/null
  done
  ls -la "$DATA" >"$dir/data-folder.txt" 2>&1

  {
    echo "ok:"; for x in "${ok[@]+"${ok[@]}"}"; do echo "  $x"; done
    echo "problems:"; for x in "${bad[@]+"${bad[@]}"}"; do echo "  $x"; done
  } >"$dir/summary.txt"

  redact "$dir"
  COPYFILE_DISABLE=1 tar -C "$DATA" -czf "$out" "$(basename "$dir")"
  rm -rf "$dir"
  chmod 600 "$out"

  echo
  for x in "${ok[@]+"${ok[@]}"}"; do printf '  ok    %s\n' "$x"; done
  for x in "${bad[@]+"${bad[@]}"}"; do printf '  FAIL  %s\n' "$x"; done
  echo
  say "wrote $out"
  say "send that file to PodTorrent support; it has logs and system details, and no node token or keys"
}

# ---- commands ----

cmd_peer() {
  [[ -x "$UV" ]] || die "missing $UV: run this from the extracted podtorrent-headless folder"
  if [[ "${PODTORRENT_SKIP_PREFLIGHT:-}" != 1 ]]; then preflight || exit 1; fi
  uv_env
  setup_backend
  gpu_check

  : >"$DATA/engine.log"
  say "starting this machine's peer on 127.0.0.1:$PORT (dashboard: http://127.0.0.1:$PORT)"
  setsid "$UV" run --frozen --project "$BACKEND" podtorrent peer --port "$PORT" "$@" \
    </dev/null > >(tee -a "$DATA/engine.log") 2>&1 &
  local peer=$! last=0 now
  trap 'stop_agent; stop_group '"$peer"'; exit 0' INT TERM
  trap 'stop_agent; stop_group '"$peer" EXIT

  # Like the desktop app: start the agent once joined and the swarm covers a model, at most every 30 s,
  # and stop it whenever the peer's API is down, so it never dials the network without a node.
  while kill -0 "$peer" 2>/dev/null; do
    if agent_running && ! node_up; then
      say "peer API is down; stopping the network agent"
      stop_agent
    elif [[ -f "$DATA/network.json" ]] && ! agent_running; then
      now=$(date +%s)
      if (( now - last >= 30 )) && start_agent; then last=$now; fi
    fi
    sleep 5
  done
  local code=0
  wait "$peer" || code=$?
  say "peer exited (code $code)"
  (( code == 0 )) || say "$HELP"
  exit "$code"
}

cmd_join() {
  local node="" network=production price_in=0 price_out=0 token=""
  while (( $# )); do
    case "$1" in
      --node) node="$2"; shift 2 ;;
      --network) network="$2"; shift 2 ;;
      --price-in) price_in="$2"; shift 2 ;;
      --price-out) price_out="$2"; shift 2 ;;
      *) die "join: unknown option $1 (options: --node ID --network production|staging --price-in N --price-out N)" ;;
    esac
  done
  [[ -n "$node" ]] || read -r -p "node id (letters, digits, - and _): " node
  node="$(tr '[:upper:]' '[:lower:]' <<<"$node")"
  [[ "$node" =~ ^[a-z0-9_-]+$ ]] || die "node id: letters, digits, - and _ only"
  [[ "$network" == production || "$network" == staging ]] || die "network: production or staging"
  [[ "$price_in" =~ ^[0-9]+(\.[0-9]+)?$ && "$price_out" =~ ^[0-9]+(\.[0-9]+)?$ ]] || die "prices must be numbers >= 0"
  mkdir -p "$DATA"
  # Read the token from the terminal without echo (or from stdin when piped), never from the command line.
  if [[ -t 0 ]]; then
    read -r -s -p "node token (Enter keeps the saved one): " token; echo
  else
    read -r token || true
  fi
  token="$(tr -d '[:space:]' <<<"$token")"
  if [[ -n "$token" ]]; then
    (umask 077; printf '%s' "$token" >"$DATA/node-token"); chmod 600 "$DATA/node-token"
  elif [[ ! -s "$DATA/node-token" ]]; then
    die "no saved node token: paste the one you were given"
  fi
  cat >"$DATA/network.json" <<EOF
{
  "node": "$node",
  "network": "$network",
  "tiers": ["interactive", "batch"],
  "price": { "per_mtok_in": $price_in, "per_mtok_out": $price_out }
}
EOF
  say "joined as $node on $network; a running peer connects within 30 s once the swarm covers a model"
}

cmd_leave() {
  rm -f "$DATA/network.json"
  say "left the network; restart the peer (or the service) to stop a running agent now"
}

unit_path() { echo "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$SERVICE"; }

cmd_install_service() {
  command -v systemctl >/dev/null || die "systemctl not found: this needs systemd"
  local unit; unit="$(unit_path)"
  mkdir -p "$(dirname "$unit")"
  cat >"$unit" <<EOF
[Unit]
Description=PodTorrent peer
After=network-online.target
Wants=network-online.target

[Service]
ExecStart="$HERE/podtorrent" peer${*:+ $*}
Environment=PODTORRENT_PORT=$PORT
Restart=on-failure
RestartSec=10
# The first start installs ROCm PyTorch (several GB).
TimeoutStartSec=infinity
KillMode=control-group

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload
  systemctl --user enable --now "$SERVICE"
  say "installed $unit and started it"
  say "logs:    journalctl --user -u podtorrent -f"
  say "status:  systemctl --user status podtorrent"
  if [[ "$(loginctl show-user "$(id -un)" -p Linger --value 2>/dev/null)" != yes ]]; then
    say "to keep the peer running after you log out and start it at boot, run once:"
    say "  sudo loginctl enable-linger $(id -un)"
  fi
}

cmd_uninstall_service() {
  systemctl --user disable --now "$SERVICE" 2>/dev/null || true
  rm -f "$(unit_path)"
  systemctl --user daemon-reload 2>/dev/null || true
  say "removed the podtorrent service"
}

usage() { sed -n '2,18p' "${BASH_SOURCE[0]}" | sed -e 's/^# \{0,1\}//' -e "s|\./podtorrent|$ME|g"; }

case "${1:-}" in
  setup) shift; cmd_setup "$@" ;;
  peer) shift; cmd_peer "$@" ;;
  join) shift; cmd_join "$@" ;;
  leave) cmd_leave ;;
  preflight) preflight ;;
  gpu-check) uv_env; setup_backend; gpu_check ;;
  doctor) cmd_doctor ;;
  install-service) shift; cmd_install_service "$@" ;;
  uninstall-service) cmd_uninstall_service ;;
  # The engine's own commands, against the running peer: models, swarm, serve, unserve, pod, video.
  top|status|models|swarm|serve|unserve|pod|video)
    uv_env
    [[ -x "$DATA/venv/bin/python" ]] || die "run $ME setup (or $ME peer) first"
    exec "$UV" run --frozen --project "$BACKEND" podtorrent "$@" ;;
  -h|--help|help|"") usage ;;
  *) usage; exit 2 ;;
esac
