{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PodTorrent",
  "version": "0.1.0",
  "identifier": "space.songjam.podtorrent",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PodTorrent",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "resources": [
      "resources/backend/**/*"
    ]
  }
}