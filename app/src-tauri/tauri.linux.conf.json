{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PodTorrent",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": true,
        "transparent": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "appimage",
      "deb"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "libnotify4"
        ]
      }
    }
  }
}
