{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "podtorrent-downloads",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "account_id": "854dc4c06088f9aebd22bc213e46a8ae",
  // Builds live in R2: releases/v<version>/<file>, plus latest.json pointing at the current ones.
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "podtorrent-releases" }],
  "routes": [
    { "pattern": "podtorrent.com/download*", "zone_name": "podtorrent.com" },
    // The headless installer: curl -fsSL https://podtorrent.com/install.sh | sh
    { "pattern": "podtorrent.com/install.sh", "zone_name": "podtorrent.com" }
  ],
  // headless/install.sh is bundled in as text, so the script served is always the one in this repo.
  "rules": [{ "type": "Text", "globs": ["**/*.sh"], "fallthrough": true }],
  "observability": { "enabled": true }
}
