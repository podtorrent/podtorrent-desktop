{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A fork: set routes and bucket_name to your own Cloudflare account's. CONTRIBUTING.md.
  "name": "podtorrent-downloads",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Builds live in R2: releases/v<version>/<file>, plus latest.json pointing at the current ones.
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "podtorrent-releases" }],
  "routes": [
    { "pattern": "podtorrent.com/download*", "zone_name": "podtorrent.com" },
    // The installers: curl -fsSL https://podtorrent.com/install.sh | sh, irm https://podtorrent.com/install.ps1 | iex
    { "pattern": "podtorrent.com/install.sh", "zone_name": "podtorrent.com" },
    { "pattern": "podtorrent.com/install.ps1", "zone_name": "podtorrent.com" }
  ],
  // install/install.sh and install.ps1 are bundled in as text, so what's served is always what's in this repo.
  "rules": [{ "type": "Text", "globs": ["**/*.sh", "**/*.ps1"], "fallthrough": true }],
  "observability": { "enabled": true }
}
